@model IEnumerable<ApplicationUser>

@{
    var userCount = ViewData["UserCount"] ?? 0;
    var roleCount = ViewData["RoleCount"] ?? 0;
}

<section class="space-y-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
            <p class="text-sm font-bold text-primary uppercase tracking-wide">Khu vực quản trị</p>
            <h1 class="text-3xl font-bold text-on-surface">Admin Dashboard</h1>
            <p class="text-secondary mt-1">Chỉ tài khoản thuộc quyền Admin mới truy cập được khu vực này.</p>
        </div>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-4 py-3 text-sm font-bold text-white hover:bg-primary-container">
            <span class="material-symbols-outlined text-[18px]">dashboard</span>
            Về Dashboard
        </a>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-bold text-secondary">Tổng tài khoản</p>
            <strong class="mt-3 block text-3xl font-bold text-on-surface">@userCount</strong>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-bold text-secondary">Tổng quyền</p>
            <strong class="mt-3 block text-3xl font-bold text-on-surface">@roleCount</strong>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <p class="text-sm font-bold text-secondary">Quyền đăng ký mặc định</p>
            <strong class="mt-3 block text-3xl font-bold text-on-surface">@SD.Role_User</strong>
        </div>
    </div>

    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-bold text-on-surface">Tài khoản mới</h2>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-secondary">@Model.Count() người dùng</span>
        </div>

        <div class="overflow-hidden rounded-lg border border-slate-200">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase text-secondary">
                    <tr>
                        <th class="px-4 py-3">Họ tên</th>
                        <th class="px-4 py-3">Email</th>
                        <th class="px-4 py-3">Ngày tạo</th>
                        <th class="px-4 py-3">Trạng thái</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="px-4 py-3 font-bold text-on-surface">@user.FullName</td>
                            <td class="px-4 py-3 text-secondary">@user.Email</td>
                            <td class="px-4 py-3 text-secondary">@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 py-3">
                                <span class="rounded-full @(user.IsActive ? "bg-success-light text-success" : "bg-danger-light text-danger") px-3 py-1 text-xs font-bold">
                                    @(user.IsActive ? "Hoạt động" : "Đã khóa")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
