@model QuizGenAI.Models.ResourceManagerViewModel
@using System.Text.Encodings.Web

<!-- Tiêu đề trang -->
<div class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
        <h2 class="font-h1 text-h1 text-on-background">Quản lý Tài liệu</h2>
        <p class="font-body text-body text-secondary">Xem, lọc, tải xuống và quản lý toàn bộ tài liệu học tập của người dùng trên hệ thống.</p>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<form method="get" action="@Url.Action("Index", "ResourceManager", new { area = "Admin" })" id="filterForm" class="p-6 border border-slate-100 dark:border-outline-variant/30 bg-white dark:bg-[#0d1c2f] rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.05)] flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-8">
    <div class="relative flex-1 max-w-lg">
        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline">search</span>
        <input type="text" name="search" value="@Model.SearchQuery" placeholder="Tìm kiếm theo tên tài liệu hoặc email..." class="w-full pl-11 pr-4 py-2.5 rounded-xl border border-slate-200 dark:border-outline-variant bg-slate-50/50 dark:bg-slate-800/20 focus:bg-white dark:focus:bg-[#0d1c2f] focus:outline-none focus:border-primary text-sm font-body text-on-surface transition-all placeholder-slate-400" />
    </div>

    <div class="flex flex-wrap items-center gap-3">
        <!-- Bộ lọc định dạng -->
        <div class="relative">
            <select name="format" onchange="this.form.submit()" class="appearance-none pl-4 pr-10 py-2.5 rounded-xl border border-slate-200 dark:border-outline-variant bg-white dark:bg-[#0d1c2f] text-sm font-semibold text-secondary hover:text-on-surface dark:text-secondary-fixed-dim transition cursor-pointer focus:outline-none focus:border-primary">
                <option value="">Tất cả định dạng</option>
                <option value="pdf" selected="@(Model.SelectedFormat == "pdf" ? "selected" : null)">PDF</option>
                <option value="docx" selected="@(Model.SelectedFormat == "docx" ? "selected" : null)">Word (.docx)</option>
                <option value="excel" selected="@(Model.SelectedFormat == "excel" ? "selected" : null)">Excel (.xlsx)</option>
                <option value="url" selected="@(Model.SelectedFormat == "url" ? "selected" : null)">URL (Trang web)</option>
                <option value="txt" selected="@(Model.SelectedFormat == "txt" ? "selected" : null)">Văn bản (.txt)</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[18px]">expand_more</span>
        </div>

        <!-- Tiêu chí sắp xếp -->
        <div class="relative">
            <select name="sortBy" onchange="this.form.submit()" class="appearance-none pl-4 pr-10 py-2.5 rounded-xl border border-slate-200 dark:border-outline-variant bg-white dark:bg-[#0d1c2f] text-sm font-semibold text-secondary hover:text-on-surface dark:text-secondary-fixed-dim transition cursor-pointer focus:outline-none focus:border-primary">
                <option value="newest" selected="@(Model.SelectedSort == "newest" ? "selected" : null)">Mới nhất</option>
                <option value="oldest" selected="@(Model.SelectedSort == "oldest" ? "selected" : null)">Cũ nhất</option>
                <option value="size_desc" selected="@(Model.SelectedSort == "size_desc" ? "selected" : null)">Kích thước lớn nhất</option>
                <option value="questions_desc" selected="@(Model.SelectedSort == "questions_desc" ? "selected" : null)">Nhiều câu hỏi nhất</option>
            </select>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[18px]">expand_more</span>
        </div>
    </div>
</form>

<!-- Bảng hiển thị danh sách -->
<div class="bg-surface rounded-2xl shadow-[0_1px_3px_rgba(0,0,0,0.06)] border border-slate-100 dark:border-outline-variant/30 overflow-hidden mb-8">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-100 dark:border-outline-variant/30 bg-slate-50/40 dark:bg-slate-800/10">
                    <th class="px-6 py-4.5 text-xs font-bold text-secondary dark:text-secondary-fixed-dim uppercase tracking-wider">Tài liệu</th>
                    <th class="px-6 py-4.5 text-xs font-bold text-secondary dark:text-secondary-fixed-dim uppercase tracking-wider">Người đăng</th>
                    <th class="px-6 py-4.5 text-xs font-bold text-secondary dark:text-secondary-fixed-dim uppercase tracking-wider">Ngày đăng</th>
                    <th class="px-6 py-4.5 text-xs font-bold text-secondary dark:text-secondary-fixed-dim uppercase tracking-wider">Dung lượng</th>
                    <th class="px-6 py-4.5 text-xs font-bold text-secondary dark:text-secondary-fixed-dim uppercase tracking-wider">Số câu hỏi</th>
                    <th class="px-6 py-4.5 text-xs font-bold text-secondary dark:text-secondary-fixed-dim uppercase tracking-wider text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-outline-variant/20">
                @if (Model.Documents == null || !Model.Documents.Any())
                {
                    <tr>
                        <td colspan="6" class="px-6 py-20 text-center text-outline dark:text-secondary-fixed-dim font-semibold">
                            <span class="material-symbols-outlined text-[54px] block mb-3 text-slate-300 dark:text-slate-700">folder_open</span>
                            Không tìm thấy tài liệu nào phù hợp trên hệ thống.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var doc in Model.Documents)
                    {
                        <tr class="hover:bg-slate-50/30 dark:hover:bg-slate-800/10 transition-colors" id="doc-row-@doc.Id">
                            <!-- Cột tài liệu -->
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3.5">
                                    <div class="w-10.5 h-10.5 rounded-xl flex items-center justify-center shrink-0 shadow-sm
                                        @(doc.Format == "pdf" ? "bg-red-50 text-red-600 dark:bg-red-950/20 dark:text-red-400" :
                                          doc.Format == "docx" ? "bg-blue-50 text-blue-600 dark:bg-blue-950/20 dark:text-blue-400" :
                                          doc.Format == "excel" ? "bg-green-50 text-green-600 dark:bg-green-950/20 dark:text-green-400" :
                                          doc.Format == "url" ? "bg-purple-50 text-purple-600 dark:bg-purple-950/20 dark:text-purple-400" : "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400")">
                                        <span class="material-symbols-outlined text-[20px]">
                                            @(doc.Format == "pdf" ? "picture_as_pdf" :
                                              doc.Format == "docx" ? "description" :
                                              doc.Format == "excel" ? "table_chart" :
                                              doc.Format == "url" ? "link" : "article")
                                        </span>
                                    </div>
                                    <div class="max-w-[240px] sm:max-w-xs lg:max-w-md">
                                        @if (doc.Format == "url")
                                        {
                                            <a href="@doc.SourceUrl" target="_blank" class="font-button text-on-surface font-semibold hover:text-primary transition-colors flex items-center gap-1.5 leading-snug">
                                                <span class="truncate block">@doc.Title</span>
                                                <span class="material-symbols-outlined text-[13px] shrink-0">open_in_new</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="font-button text-on-surface font-semibold block truncate leading-snug" title="@doc.Title">@doc.Title</span>
                                        }
                                        <span class="text-[11px] text-outline dark:text-secondary-fixed-dim block truncate mt-0.5 font-medium">@doc.Description</span>
                                    </div>
                                </div>
                            </td>
                            <!-- Cột người đăng -->
                            <td class="px-6 py-4">
                                <span class="font-semibold text-on-surface block text-sm leading-normal">@doc.OwnerName</span>
                                <span class="text-xs text-outline dark:text-secondary-fixed-dim block font-medium">@doc.OwnerEmail</span>
                            </td>
                            <!-- Cột ngày đăng -->
                            <td class="px-6 py-4 text-sm text-secondary dark:text-secondary-fixed-dim font-medium">
                                @doc.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <!-- Cột kích thước -->
                            <td class="px-6 py-4 text-sm text-secondary dark:text-secondary-fixed-dim font-medium">
                                @doc.FileSize
                            </td>
                            <!-- Cột số câu hỏi -->
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-primary-fixed text-primary shadow-sm dark:bg-primary-fixed-dim dark:text-[#b7c4ff]">
                                    @doc.QuestionsCount câu hỏi
                                </span>
                            </td>
                            <!-- Cột thao tác -->
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <button type="button" onclick="openDetailModal(@doc.Id)" class="p-2 rounded-xl text-secondary hover:bg-slate-50 hover:text-on-surface dark:text-secondary-fixed-dim dark:hover:bg-slate-800 transition cursor-pointer flex items-center" title="Xem chi tiết">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </button>
                                    @if (doc.Format != "url")
                                    {
                                        <a href="@Url.Action("DownloadDocument", "ResourceManager", new { area = "Admin", id = doc.Id })" class="p-2 rounded-xl text-secondary hover:bg-slate-50 hover:text-on-surface dark:text-secondary-fixed-dim dark:hover:bg-slate-800 transition cursor-pointer flex items-center" title="Tải xuống file">
                                            <span class="material-symbols-outlined text-[18px]">download</span>
                                        </a>
                                    }
                                    <button type="button" onclick="confirmDelete(@doc.Id, '@JavaScriptEncoder.Default.Encode(doc.Title)')" class="p-2 rounded-xl text-red-600 hover:bg-red-50 dark:hover:bg-red-950/20 transition cursor-pointer flex items-center" title="Xóa tài liệu">
                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-6 border-t border-slate-100 dark:border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-4">
            <span class="text-xs text-outline dark:text-secondary-fixed-dim font-semibold">
                Hiển thị @(((Model.CurrentPage - 1) * Model.PageSize) + 1) - @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) trong tổng số @Model.TotalItems tài liệu
            </span>
            <div class="flex items-center gap-1.5">
                @if (Model.CurrentPage > 1)
                {
                    <a href="@Url.Action("Index", "ResourceManager", new { area = "Admin", search = Model.SearchQuery, format = Model.SelectedFormat, sortBy = Model.SelectedSort, page = Model.CurrentPage - 1 })" class="p-2 rounded-xl border border-slate-200 dark:border-outline-variant bg-white dark:bg-[#0d1c2f] hover:bg-slate-50 dark:hover:bg-slate-800 transition-all text-secondary dark:text-secondary-fixed-dim flex items-center shadow-sm">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </a>
                }
                else
                {
                    <button disabled class="p-2 rounded-xl border border-slate-100 dark:border-outline-variant bg-slate-50 dark:bg-slate-800/10 text-slate-300 dark:text-slate-700 cursor-not-allowed flex items-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.CurrentPage)
                    {
                        <span class="px-3.5 py-1.5 rounded-xl bg-primary text-white text-xs font-bold shadow-sm">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "ResourceManager", new { area = "Admin", search = Model.SearchQuery, format = Model.SelectedFormat, sortBy = Model.SelectedSort, page = i })" class="px-3.5 py-1.5 rounded-xl border border-slate-200 dark:border-outline-variant bg-white dark:bg-[#0d1c2f] hover:bg-slate-50 dark:hover:bg-slate-800 text-secondary dark:text-secondary-fixed-dim text-xs font-bold transition-all shadow-sm">@i</a>
                    }
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="@Url.Action("Index", "ResourceManager", new { area = "Admin", search = Model.SearchQuery, format = Model.SelectedFormat, sortBy = Model.SelectedSort, page = Model.CurrentPage + 1 })" class="p-2 rounded-xl border border-slate-200 dark:border-outline-variant bg-white dark:bg-[#0d1c2f] hover:bg-slate-50 dark:hover:bg-slate-800 transition-all text-secondary dark:text-secondary-fixed-dim flex items-center shadow-sm">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </a>
                }
                else
                {
                    <button disabled class="p-2 rounded-xl border border-slate-100 dark:border-outline-variant bg-slate-50 dark:bg-slate-800/10 text-slate-300 dark:text-slate-700 cursor-not-allowed flex items-center">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                }
            </div>
        </div>
    }
</div>

<!-- Modal Chi tiết tài liệu -->
<div id="detail-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="bg-white dark:bg-[#0d1c2f] rounded-2xl w-full max-w-2xl max-h-[85vh] flex flex-col shadow-2xl border border-slate-200/60 dark:border-outline-variant transform scale-95 transition-all duration-300 m-4">
        <!-- Header -->
        <div class="px-6 py-5 border-b border-slate-100 dark:border-outline-variant flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined text-primary text-[24px]" id="modal-format-icon">description</span>
                <h3 class="font-h3 text-h3 text-on-surface" id="modal-title">Chi tiết tài liệu</h3>
            </div>
            <button onclick="closeDetailModal()" class="text-secondary hover:text-on-surface dark:text-secondary-fixed-dim dark:hover:text-white p-1.5 rounded-lg hover:bg-slate-150 transition cursor-pointer">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <!-- Body -->
        <div class="p-6 overflow-y-auto space-y-6 flex-1">
            <!-- Metadata Grid -->
            <div class="grid grid-cols-2 gap-4 bg-slate-50 dark:bg-[#132337] p-4 rounded-xl border border-slate-100 dark:border-outline-variant/30 text-xs font-semibold text-secondary dark:text-secondary-fixed-dim">
                <div>
                    <span class="text-outline dark:text-secondary-fixed-dim/60 block mb-1">Người tải lên</span>
                    <span class="text-on-surface font-bold text-sm" id="modal-owner">...</span>
                </div>
                <div>
                    <span class="text-outline dark:text-secondary-fixed-dim/60 block mb-1">Thời gian tạo</span>
                    <span class="text-on-surface font-bold text-sm" id="modal-date">...</span>
                </div>
                <div>
                    <span class="text-outline dark:text-secondary-fixed-dim/60 block mb-1">Dung lượng</span>
                    <span class="text-on-surface font-bold text-sm" id="modal-size">...</span>
                </div>
                <div>
                    <span class="text-outline dark:text-secondary-fixed-dim/60 block mb-1">Số trang</span>
                    <span class="text-on-surface font-bold text-sm" id="modal-pages">...</span>
                </div>
            </div>

            <!-- Mô tả -->
            <div id="modal-desc-container">
                <h4 class="text-xs font-bold text-primary uppercase tracking-wide mb-2">Mô tả</h4>
                <p class="text-sm text-secondary dark:text-secondary-fixed-dim leading-relaxed" id="modal-description">...</p>
            </div>

            <!-- Văn bản trích xuất -->
            <div>
                <h4 class="text-xs font-bold text-primary uppercase tracking-wide mb-2">Nội dung văn bản gốc đã trích xuất</h4>
                <div class="bg-slate-50 dark:bg-[#132337] p-4 rounded-xl border border-slate-100 dark:border-outline-variant/30 max-h-60 overflow-y-auto">
                    <pre class="text-xs text-secondary dark:text-secondary-fixed-dim leading-relaxed font-mono whitespace-pre-wrap" id="modal-text">...</pre>
                </div>
            </div>
        </div>
        <!-- Footer -->
        <div class="px-6 py-4 border-t border-slate-100 dark:border-outline-variant flex justify-end gap-3 bg-slate-50/20 dark:bg-slate-800/10">
            <button onclick="closeDetailModal()" class="px-5 py-2.5 rounded-xl text-xs font-bold text-secondary dark:text-secondary-fixed-dim hover:bg-slate-100 dark:hover:bg-slate-850 transition border border-slate-200 dark:border-outline-variant cursor-pointer bg-white dark:bg-[#0d1c2f]">
                Đóng
            </button>
        </div>
    </div>
</div>

<!-- Modal Xác nhận xóa -->
<div id="delete-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="bg-white dark:bg-[#0d1c2f] rounded-2xl w-full max-w-md shadow-2xl border border-slate-200/60 dark:border-outline-variant p-6 transform scale-95 transition-all duration-300 m-4">
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-red-50 dark:bg-red-950/20 text-red-600 dark:text-red-400 flex items-center justify-center shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-[22px]">warning</span>
            </div>
            <div>
                <h3 class="font-h3 text-h3 text-on-surface mb-2">Xóa tài liệu?</h3>
                <p class="text-sm text-secondary dark:text-secondary-fixed-dim leading-relaxed mb-6">
                    Bạn có chắc chắn muốn xóa tài liệu <strong class="text-on-surface dark:text-white font-semibold" id="delete-doc-title"></strong>? Hành động này sẽ gỡ bỏ dữ liệu khỏi hệ thống và có thể ảnh hưởng đến các bộ đề liên kết.
                </p>
            </div>
        </div>
        <input type="hidden" id="delete-doc-id" />
        <div class="flex justify-end gap-3">
            <button onclick="closeDeleteModal()" class="px-4 py-2 rounded-xl text-xs font-bold text-secondary dark:text-secondary-fixed-dim hover:bg-slate-100 dark:hover:bg-slate-800 transition border border-slate-200 dark:border-outline-variant cursor-pointer bg-white dark:bg-[#0d1c2f]">
                Hủy bỏ
            </button>
            <button onclick="executeDelete()" class="px-4 py-2 rounded-xl text-xs font-bold bg-red-600 text-white hover:bg-red-700 transition shadow-sm cursor-pointer">
                Đồng ý xóa
            </button>
        </div>
    </div>
</div>

<!-- Toast phản hồi -->
<div id="status-toast" class="fixed bottom-5 right-5 z-50 transform translate-y-10 opacity-0 transition-all duration-300 flex items-center gap-3 bg-white dark:bg-[#132337] border border-slate-200 dark:border-outline-variant rounded-xl p-4 shadow-lg max-w-sm pointer-events-none">
    <div id="toast-icon-container" class="w-8 h-8 rounded-lg flex items-center justify-center text-white shrink-0">
        <span id="toast-icon" class="material-symbols-outlined text-[18px]">check</span>
    </div>
    <p id="toast-message" class="text-xs font-semibold text-on-surface dark:text-on-primary-container leading-normal"></p>
</div>

@section Scripts {
    <script>
        // Mở modal chi tiết và tải dữ liệu qua AJAX
        function openDetailModal(id) {
            $.get('@Url.Action("GetDocumentDetail", "ResourceManager", new { area = "Admin" })', { id: id }, function (response) {
                if (response.success) {
                    $('#modal-title').text(response.title);
                    $('#modal-owner').text(response.ownerName + " (" + response.ownerEmail + ")");
                    $('#modal-date').text(response.createdAt);
                    $('#modal-size').text(response.fileSize);
                    $('#modal-pages').text(response.pageCount > 0 ? response.pageCount + " trang" : "N/A");
                    $('#modal-description').text(response.description || "Không có mô tả.");
                    $('#modal-text').text(response.extractedText);

                    // Đổi icon tương ứng định dạng
                    let icon = "article";
                    if (response.format === "pdf") icon = "picture_as_pdf";
                    else if (response.format === "docx") icon = "description";
                    else if (response.format === "excel") icon = "table_chart";
                    else if (response.format === "url") icon = "link";
                    $('#modal-format-icon').text(icon);

                    // Trượt mở modal
                    const modal = document.getElementById('detail-modal');
                    modal.classList.remove('opacity-0', 'pointer-events-none');
                    modal.querySelector('.transform').classList.remove('scale-95');
                    modal.querySelector('.transform').classList.add('scale-100');
                } else {
                    showToast(response.message || "Lỗi tải thông tin chi tiết.", false);
                }
            }).fail(function () {
                showToast("Lỗi kết nối máy chủ.", false);
            });
        }

        // Đóng modal chi tiết
        function closeDetailModal() {
            const modal = document.getElementById('detail-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.querySelector('.transform').classList.remove('scale-100');
            modal.querySelector('.transform').classList.add('scale-95');
        }

        // Mở modal xác nhận xóa
        function confirmDelete(id, title) {
            $('#delete-doc-title').text(title);
            $('#delete-doc-id').val(id);

            const modal = document.getElementById('delete-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.querySelector('.transform').classList.remove('scale-95');
            modal.querySelector('.transform').classList.add('scale-100');
        }

        // Đóng modal xác nhận xóa
        function closeDeleteModal() {
            const modal = document.getElementById('delete-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.querySelector('.transform').classList.remove('scale-100');
            modal.querySelector('.transform').classList.add('scale-95');
        }

        // Thực thi cuộc gọi xóa tài liệu AJAX
        function executeDelete() {
            const id = $('#delete-doc-id').val();
            
            $.post('@Url.Action("DeleteDocument", "ResourceManager", new { area = "Admin" })', { id: id }, function (response) {
                closeDeleteModal();
                if (response.success) {
                    showToast(response.message, true);
                    // Ẩn mờ dòng trên DOM
                    $(`#doc-row-${id}`).fadeOut(400, function() {
                        $(this).remove();
                    });
                } else {
                    showToast(response.message || "Không thể xóa tài liệu.", false);
                }
            }).fail(function () {
                closeDeleteModal();
                showToast("Lỗi kết nối máy chủ.", false);
            });
        }

        // Hiện Toast thông báo
        function showToast(message, isSuccess = true) {
            const toast = document.getElementById('status-toast');
            const toastIconContainer = document.getElementById('toast-icon-container');
            const toastIcon = document.getElementById('toast-icon');
            const toastMsg = document.getElementById('toast-message');

            toastMsg.innerText = message;

            if (isSuccess) {
                toastIconContainer.className = "w-8 h-8 rounded-lg bg-success text-white flex items-center justify-center shrink-0 shadow-sm";
                toastIcon.innerText = "check";
            } else {
                toastIconContainer.className = "w-8 h-8 rounded-lg bg-red-600 text-white flex items-center justify-center shrink-0 shadow-sm";
                toastIcon.innerText = "error";
            }

            toast.classList.remove('translate-y-10', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-10', 'opacity-0');
            }, 3000);
        }
    </script>
}
