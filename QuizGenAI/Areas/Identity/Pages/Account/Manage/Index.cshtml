@page
@model IndexModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
    ViewData["ActivePage"] = "UserSettings";
    ViewData["ManagePage"] = "Profile";
    var avatarSource = string.IsNullOrWhiteSpace(Model.Input.FullName) ? Model.Email : Model.Input.FullName;
    var avatarInitial = string.IsNullOrWhiteSpace(avatarSource) ? "Q" : avatarSource.Trim()[0].ToString().ToUpperInvariant();
}

<div class="mb-8">
    <h1 class="text-h1 font-h1 text-on-surface dark:text-primary-fixed-dim">Cài đặt tài khoản</h1>
    <p class="mt-2 text-body text-secondary dark:text-secondary-fixed-dim">Quản lý thông tin cá nhân và bảo mật tài khoản của bạn.</p>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[240px_minmax(0,1fr)]">
    <aside class="h-fit rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-outline-variant dark:bg-on-secondary-fixed">
        <partial name="_ManageNav" />
    </aside>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-outline-variant dark:bg-on-secondary-fixed md:p-8">
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="mb-6">
            <h2 class="text-h2 font-h2 text-on-surface dark:text-primary-fixed-dim">Thông tin cá nhân</h2>
            <p class="mt-1 text-sm text-secondary dark:text-secondary-fixed-dim">Cập nhật thông tin hiển thị và ảnh đại diện.</p>
        </div>

        <form method="post" enctype="multipart/form-data" class="space-y-8">
            <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></div>

            <div class="flex flex-col gap-5 rounded-2xl bg-slate-50 p-5 dark:bg-surface-dim/10 sm:flex-row sm:items-center">
                <div class="h-24 w-24 shrink-0 overflow-hidden rounded-full border-4 border-white bg-primary text-white shadow-sm dark:border-outline-variant">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarPath))
                    {
                        <img id="avatar-preview" src="@Model.AvatarPath" alt="Ảnh đại diện" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <div id="avatar-fallback" class="flex h-full w-full items-center justify-center text-3xl font-bold">@avatarInitial</div>
                        <img id="avatar-preview" src="" alt="Ảnh đại diện" class="hidden h-full w-full object-cover" />
                    }
                </div>
                <div class="flex-1">
                    <label asp-for="Input.Avatar" class="mb-2 block text-sm font-semibold text-on-surface dark:text-on-primary-container"></label>
                    <input asp-for="Input.Avatar" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                           class="block w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-secondary file:mr-4 file:rounded-lg file:border-0 file:bg-primary file:px-4 file:py-2 file:font-semibold file:text-white hover:file:bg-primary/90 dark:border-outline-variant dark:bg-on-secondary-fixed dark:text-secondary-fixed-dim" />
                    <span asp-validation-for="Input.Avatar" class="mt-1 block text-sm text-red-600"></span>
                    <p class="mt-2 text-xs text-secondary dark:text-secondary-fixed-dim">JPG, PNG hoặc WEBP, tối đa 2 MB.</p>

                    @if (!string.IsNullOrWhiteSpace(Model.AvatarPath))
                    {
                        <label class="mt-3 inline-flex items-center gap-2 text-sm text-secondary dark:text-secondary-fixed-dim">
                            <input asp-for="Input.RemoveAvatar" class="rounded border-slate-300 text-primary focus:ring-primary" />
                            <span>Xóa ảnh đại diện hiện tại</span>
                        </label>
                    }
                </div>
            </div>

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label asp-for="Input.FullName" class="mb-2 block text-sm font-semibold text-on-surface dark:text-on-primary-container"></label>
                    <input asp-for="Input.FullName" class="w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-primary dark:border-outline-variant dark:bg-on-secondary-fixed" />
                    <span asp-validation-for="Input.FullName" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="Input.PhoneNumber" class="mb-2 block text-sm font-semibold text-on-surface dark:text-on-primary-container"></label>
                    <input asp-for="Input.PhoneNumber" class="w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-primary dark:border-outline-variant dark:bg-on-secondary-fixed" />
                    <span asp-validation-for="Input.PhoneNumber" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Input.Address" class="mb-2 block text-sm font-semibold text-on-surface dark:text-on-primary-container"></label>
                    <textarea asp-for="Input.Address" rows="3" class="w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-primary dark:border-outline-variant dark:bg-on-secondary-fixed"></textarea>
                    <span asp-validation-for="Input.Address" class="mt-1 block text-sm text-red-600"></span>
                </div>
            </div>

            <div class="border-t border-slate-200 pt-6 dark:border-outline-variant">
                <h3 class="mb-4 text-sm font-bold uppercase tracking-wide text-secondary dark:text-secondary-fixed-dim">Thông tin tài khoản</h3>
                <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div class="rounded-xl bg-slate-50 p-4 dark:bg-surface-dim/10">
                        <dt class="text-xs font-semibold text-secondary dark:text-secondary-fixed-dim">Email</dt>
                        <dd class="mt-1 break-all text-sm font-semibold text-on-surface dark:text-on-primary-container">@Model.Email</dd>
                    </div>
                    <div class="rounded-xl bg-slate-50 p-4 dark:bg-surface-dim/10">
                        <dt class="text-xs font-semibold text-secondary dark:text-secondary-fixed-dim">Vai trò</dt>
                        <dd class="mt-1 text-sm font-semibold text-on-surface dark:text-on-primary-container">@Model.Roles</dd>
                    </div>
                    <div class="rounded-xl bg-slate-50 p-4 dark:bg-surface-dim/10">
                        <dt class="text-xs font-semibold text-secondary dark:text-secondary-fixed-dim">Ngày tham gia</dt>
                        <dd class="mt-1 text-sm font-semibold text-on-surface dark:text-on-primary-container">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    <div class="rounded-xl bg-slate-50 p-4 dark:bg-surface-dim/10">
                        <dt class="text-xs font-semibold text-secondary dark:text-secondary-fixed-dim">Trạng thái</dt>
                        <dd class="mt-1 text-sm font-semibold text-success">@Model.AccountStatus</dd>
                    </div>
                    <div class="rounded-xl bg-slate-50 p-4 dark:bg-surface-dim/10">
                        <dt class="text-xs font-semibold text-secondary dark:text-secondary-fixed-dim">Xác thực email</dt>
                        <dd class="mt-1 text-sm font-semibold @(Model.EmailConfirmed ? "text-success" : "text-warning")">@(Model.EmailConfirmed ? "Đã xác thực" : "Chưa xác thực")</dd>
                    </div>
                    <div class="rounded-xl bg-slate-50 p-4 dark:bg-surface-dim/10 sm:col-span-2">
                        <dt class="text-xs font-semibold text-secondary dark:text-secondary-fixed-dim">Mã tài khoản</dt>
                        <dd class="mt-1 break-all font-mono text-xs font-semibold text-on-surface dark:text-on-primary-container">@Model.UserId</dd>
                    </div>
                </dl>
            </div>

            <div class="flex justify-end">
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary/90">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const avatarInput = document.getElementById('Input_Avatar');
        const avatarPreview = document.getElementById('avatar-preview');
        const avatarFallback = document.getElementById('avatar-fallback');

        avatarInput?.addEventListener('change', function () {
            const file = this.files?.[0];
            if (!file || !avatarPreview) return;

            avatarPreview.src = URL.createObjectURL(file);
            avatarPreview.classList.remove('hidden');
            avatarFallback?.classList.add('hidden');
        });
    </script>
}
