@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = "UserSettings";
    ViewData["ManagePage"] = "Password";
}

<div class="mb-8">
    <h1 class="text-h1 font-h1 text-on-surface dark:text-primary-fixed-dim">Cài đặt tài khoản</h1>
    <p class="mt-2 text-body text-secondary dark:text-secondary-fixed-dim">Quản lý thông tin cá nhân và bảo mật tài khoản của bạn.</p>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[240px_minmax(0,1fr)]">
    <aside class="h-fit rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-outline-variant dark:bg-on-secondary-fixed">
        <partial name="_ManageNav" />
    </aside>

    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-outline-variant dark:bg-on-secondary-fixed md:p-8">
        <partial name="_StatusMessage" for="StatusMessage" />

        <h2 class="text-h2 font-h2 text-on-surface dark:text-primary-fixed-dim">Đổi mật khẩu</h2>
        <p class="mt-1 text-sm text-secondary dark:text-secondary-fixed-dim">Mật khẩu mới cần có ít nhất 8 ký tự, gồm chữ hoa, chữ thường và chữ số.</p>

        <form method="post" class="mt-8 max-w-xl space-y-5">
            <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"></div>

            <div>
                <label asp-for="Input.OldPassword" class="mb-2 block text-sm font-semibold text-on-surface dark:text-on-primary-container"></label>
                <input asp-for="Input.OldPassword" autocomplete="current-password" class="w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-primary dark:border-outline-variant dark:bg-on-secondary-fixed" />
                <span asp-validation-for="Input.OldPassword" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="Input.NewPassword" class="mb-2 block text-sm font-semibold text-on-surface dark:text-on-primary-container"></label>
                <input asp-for="Input.NewPassword" autocomplete="new-password" class="w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-primary dark:border-outline-variant dark:bg-on-secondary-fixed" />
                <span asp-validation-for="Input.NewPassword" class="mt-1 block text-sm text-red-600"></span>
            </div>
            <div>
                <label asp-for="Input.ConfirmPassword" class="mb-2 block text-sm font-semibold text-on-surface dark:text-on-primary-container"></label>
                <input asp-for="Input.ConfirmPassword" autocomplete="new-password" class="w-full rounded-xl border-slate-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-primary dark:border-outline-variant dark:bg-on-secondary-fixed" />
                <span asp-validation-for="Input.ConfirmPassword" class="mt-1 block text-sm text-red-600"></span>
            </div>

            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary/90">
                <span class="material-symbols-outlined text-[18px]">lock_reset</span>
                Đổi mật khẩu
            </button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
