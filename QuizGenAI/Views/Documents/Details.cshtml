@section Scripts {
    <script>
        const toggleDocumentTextBtn = document.getElementById("toggleDocumentTextBtn");
        const documentTextWrapper = document.querySelector(".stitch-document-text-wrapper");

        if (toggleDocumentTextBtn && documentTextWrapper) {
            toggleDocumentTextBtn.addEventListener("click", function () {
                const isCollapsed = documentTextWrapper.classList.contains("collapsed");

                documentTextWrapper.classList.toggle("collapsed", !isCollapsed);
                documentTextWrapper.classList.toggle("expanded", isCollapsed);

                toggleDocumentTextBtn.textContent = isCollapsed
                    ? "Thu gọn nội dung"
                    : "Xem thêm nội dung";
            });
        }

        // Xử lý sự kiện click nút toggle public/private
        document.querySelectorAll(".btn-toggle-public").forEach(button => {
            button.addEventListener("click", function(e) {
                e.preventDefault();
                e.stopPropagation();

                const btn = this;
                const quizSetId = btn.dataset.quizsetId;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                if (!token) {
                    alert("Không tìm thấy CSRF token.");
                    return;
                }

                fetch('/Documents/TogglePublic', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        'quizSetId': quizSetId,
                        '__RequestVerificationToken': token
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        if (data.isPublic) {
                            btn.className = "btn-toggle-public public";
                            btn.title = "Đang công khai. Nhấn để chuyển sang riêng tư";
                            btn.querySelector(".material-symbols-outlined").textContent = "public";
                            btn.querySelector("span:not(.material-symbols-outlined)").textContent = "Công khai";
                        } else {
                            btn.className = "btn-toggle-public private";
                            btn.title = "Đang riêng tư. Nhấn để công khai bộ đề";
                            btn.querySelector(".material-symbols-outlined").textContent = "lock";
                            btn.querySelector("span:not(.material-symbols-outlined)").textContent = "Riêng tư";
                        }
                    } else {
                        alert(data.message || "Đã xảy ra lỗi khi cập nhật trạng thái.");
                    }
                })
                .catch(error => {
                    console.error("Error:", error);
                    alert("Không thể kết nối tới máy chủ.");
                });
            });
        });

        // Xử lý sự kiện click nút xóa ở trang chi tiết tài liệu
        const btnDeleteDocDetails = document.getElementById("btn-delete-document-details");
        if (btnDeleteDocDetails) {
            btnDeleteDocDetails.addEventListener("click", function (e) {
                e.preventDefault();
                
                window.showConfirmModal({
                    title: "Xóa tài liệu",
                    message: "Bạn có chắc chắn muốn xóa tài liệu này không?<br><br><span class='text-red-600 dark:text-red-400 font-semibold'>Lưu ý:</span> Hành động này cũng sẽ xóa toàn bộ các bộ đề thi liên quan và không thể hoàn tác.",
                    onConfirm: function () {
                        document.getElementById("deleteDocumentFormDetails").submit();
                    }
                });
            });
        }

        // -------------------------------------------------------------
        // XỬ LÝ MODAL TÓM TẮT AI
        // -------------------------------------------------------------
        const btnAiSummarize = document.getElementById("btn-ai-summarize");
        const modalAiSummary = document.getElementById("ai-summary-modal");
        const overlayAiSummary = document.getElementById("ai-summary-overlay");
        const boxAiSummary = document.getElementById("ai-summary-box");
        const btnCloseHeader = document.getElementById("ai-summary-close-btn");
        const btnCloseFooter = document.getElementById("ai-summary-btn-close");
        const btnCreateQuiz = document.getElementById("ai-summary-btn-create-quiz");

        const loadingDiv = document.getElementById("ai-summary-loading");
        const contentDiv = document.getElementById("ai-summary-content");
        const textSummaryDiv = document.getElementById("ai-summary-text");
        const listKeypointsUl = document.getElementById("ai-summary-keypoints");
        const textAudienceP = document.getElementById("ai-summary-audience");

        function showAiSummaryModal() {
            modalAiSummary.classList.remove("hidden");
            modalAiSummary.classList.add("flex");
            setTimeout(() => {
                overlayAiSummary.classList.remove("opacity-0");
                overlayAiSummary.classList.add("opacity-100");
                boxAiSummary.classList.remove("scale-95", "opacity-0");
                boxAiSummary.classList.add("scale-100", "opacity-100");
            }, 10);
        }

        function hideAiSummaryModal() {
            overlayAiSummary.classList.remove("opacity-100");
            overlayAiSummary.classList.add("opacity-0");
            boxAiSummary.classList.remove("scale-100", "opacity-100");
            boxAiSummary.classList.add("scale-95", "opacity-0");
            setTimeout(() => {
                modalAiSummary.classList.remove("flex");
                modalAiSummary.classList.add("hidden");
            }, 300);
        }

        [btnCloseHeader, btnCloseFooter, overlayAiSummary].forEach(el => {
            if (el) el.addEventListener("click", hideAiSummaryModal);
        });

        function renderSummaryData(summary, keyPoints, audience) {
            // Hiển thị tóm tắt chính (chia theo các đoạn)
            textSummaryDiv.innerHTML = "";
            const paragraphs = summary.split("\n");
            paragraphs.forEach(pText => {
                if (pText.trim()) {
                    const p = document.createElement("p");
                    p.className = "mb-3 text-justify leading-relaxed text-[#131b2e] dark:text-slate-300";
                    p.textContent = pText.trim();
                    textSummaryDiv.appendChild(p);
                }
            });

            // Hiển thị điểm nổi bật
            listKeypointsUl.innerHTML = "";
            let points = [];
            if (Array.isArray(keyPoints)) {
                points = keyPoints;
            } else if (typeof keyPoints === 'string') {
                try {
                    points = JSON.parse(keyPoints);
                } catch (e) {
                    points = keyPoints.split("\n").map(x => x.trim()).filter(x => x);
                }
            }

            points.forEach(point => {
                const li = document.createElement("li");
                li.className = "flex items-start gap-2.5 text-[13px] text-slate-600 dark:text-slate-300 font-medium";
                li.innerHTML = `
                    <span class="material-symbols-outlined text-indigo-500 dark:text-indigo-400 text-[18px] shrink-0 mt-0.5">check_circle</span>
                    <span class="leading-relaxed">${point}</span>
                `;
                listKeypointsUl.appendChild(li);
            });

            // Hiển thị đối tượng
            textAudienceP.textContent = audience || "Chưa có thông tin.";

            // Switch views
            loadingDiv.classList.add("hidden");
            contentDiv.classList.remove("hidden");
            btnCreateQuiz.classList.remove("hidden");
        }

        if (btnAiSummarize) {
            btnAiSummarize.addEventListener("click", function () {
                const hasSummary = btnAiSummarize.getAttribute("data-has-summary") === "true";
                
                showAiSummaryModal();

                if (hasSummary) {
                    // Load từ cache đã có sẵn trên giao diện
                    const summary = btnAiSummarize.getAttribute("data-summary");
                    const keyPoints = btnAiSummarize.getAttribute("data-keypoints");
                    const audience = btnAiSummarize.getAttribute("data-audience");
                    renderSummaryData(summary, keyPoints, audience);
                } else {
                    // Mở chế độ loading
                    loadingDiv.classList.remove("hidden");
                    contentDiv.classList.add("hidden");
                    btnCreateQuiz.classList.add("hidden");

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    const docId = "@Model.Id";

                    fetch("/Documents/Summarize", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                        },
                        body: new URLSearchParams({
                            "id": docId,
                            "__RequestVerificationToken": token
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            // Cập nhật thuộc tính của nút bấm để dùng làm cache cho lần click tiếp theo
                            btnAiSummarize.setAttribute("data-has-summary", "true");
                            btnAiSummarize.setAttribute("data-summary", data.summary);
                            btnAiSummarize.setAttribute("data-keypoints", JSON.stringify(data.keyPoints));
                            btnAiSummarize.setAttribute("data-audience", data.audience);

                            renderSummaryData(data.summary, data.keyPoints, data.audience);
                        } else {
                            hideAiSummaryModal();
                            alert(data.message || "Không thể tải tóm tắt AI.");
                        }
                    })
                    .catch(error => {
                        console.error("Error summarize:", error);
                        hideAiSummaryModal();
                        alert("Không thể kết nối tới máy chủ.");
                    });
                }
            });
        }
    </script>
}
