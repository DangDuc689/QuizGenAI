@model QuizGenAI.Models.Document

@Html.AntiForgeryToken()

@{
    ViewData["Title"] = "Chi tiết tài liệu";

    var textLength = Model.SourceType == QuizGenAI.Models.DocumentSourceType.PDF
        ? RemovePdfMetadataBlock(Model.ExtractedText).Length
        : (Model.ExtractedText?.Length ?? 0);

    var estimatedQuestions = textLength switch
    {
        < 500 => "5 - 10 câu",
        < 2000 => "10 - 20 câu",
        < 5000 => "20 - 35 câu",
        _ => "35 - 50 câu"
    };

    var contentLevel = textLength switch
    {
        < 1000 => "Cơ bản",
        < 4000 => "Trung bình",
        _ => "Nâng cao"
    };

    var mainTopic = Model.Title;

    var badgeClass = Model.SourceType switch
    {
        QuizGenAI.Models.DocumentSourceType.PDF => "pdf",
        QuizGenAI.Models.DocumentSourceType.Word => "word",
        QuizGenAI.Models.DocumentSourceType.URL => "url",
        QuizGenAI.Models.DocumentSourceType.Excel => "excel",
        _ => "text"
    };

    var isUrlDocument = Model.SourceType == QuizGenAI.Models.DocumentSourceType.URL;
    var isPdfDocument = Model.SourceType == QuizGenAI.Models.DocumentSourceType.PDF;
    var rawExtractedText = Model.ExtractedText ?? string.Empty;
    var pdfMetadata = isPdfDocument
        ? ParsePdfExtractionMetadata(rawExtractedText)
        : null;
    var extractedText = isPdfDocument
        ? RemovePdfMetadataBlock(rawExtractedText)
        : rawExtractedText;
    var hasExtractedText = !string.IsNullOrWhiteSpace(extractedText);
    var normalTextSectionHeading = isPdfDocument
        ? QuizGenAI.Services.PdfExtractionService.NormalTextSectionHeading
        : QuizGenAI.Services.DocxExtractionService.NormalTextSectionHeading;
    var imageTextSectionHeading = isPdfDocument
        ? QuizGenAI.Services.PdfExtractionService.ImageTextSectionHeading
        : QuizGenAI.Services.DocxExtractionService.ImageTextSectionHeading;
    var imageUnreadableMessage = isPdfDocument
        ? QuizGenAI.Services.PdfExtractionService.ImageUnreadableMessage
        : QuizGenAI.Services.DocxExtractionService.ImageUnreadableMessage;
    var imageVisionTroubleshootingMessage = isPdfDocument
        ? "__PDF_IMAGE_VISION_TROUBLESHOOTING_UNUSED__"
        : QuizGenAI.Services.DocxExtractionService.ImageVisionTroubleshootingMessage;
    var sourceTextSectionTitle = isPdfDocument
        ? "Nội dung văn bản trích xuất từ PDF"
        : "Nội dung văn bản trích xuất từ Word";
    var imageTextSectionTitle = isPdfDocument
        ? "Nội dung nhận diện từ hình ảnh trong PDF"
        : "Nội dung nhận diện từ hình ảnh trong tài liệu";
    var imageSectionStart = extractedText.IndexOf(imageTextSectionHeading, StringComparison.Ordinal);
    var hasImageTextSection = imageSectionStart >= 0;
    var normalExtractedText = extractedText;
    var imageExtractedText = string.Empty;

    if (hasImageTextSection)
    {
        normalExtractedText = extractedText[..imageSectionStart].Trim();
        imageExtractedText = extractedText[(imageSectionStart + imageTextSectionHeading.Length)..].Trim();

        if (normalExtractedText.StartsWith(normalTextSectionHeading, StringComparison.Ordinal))
        {
            normalExtractedText = normalExtractedText[normalTextSectionHeading.Length..].Trim();
        }
    }

    var cleanNormalText = CleanDocumentTextForCounting(normalExtractedText, imageUnreadableMessage, imageVisionTroubleshootingMessage);
    var cleanImageTextForDisplay = CleanImageTextForDisplay(imageExtractedText, imageUnreadableMessage, imageVisionTroubleshootingMessage);
    var normalUsefulWords = CountUsefulWords(cleanNormalText);
    var imageUsefulWords = CountUsefulWords(cleanImageTextForDisplay);
    var hasPdfMetadata = pdfMetadata?.IsPresent == true;
    var pdfHasEnoughRawText = hasPdfMetadata
        ? pdfMetadata!.HasEnoughRawText
        : normalUsefulWords >= 80 || HasEnoughMathLearningSignals(cleanNormalText);
    var metadataHasImageContent = hasPdfMetadata && pdfMetadata!.HasImageContent;
    var parsedReadableImageCount = CountReadableImageSections(imageExtractedText);
    var parsedDetectedImageCount = GetDetectedImageCount(imageExtractedText, parsedReadableImageCount, hasImageTextSection);
    var readableImageCount = isPdfDocument && hasPdfMetadata
        ? pdfMetadata!.RecognizedImageCount
        : parsedReadableImageCount;
    var detectedImageCount = isPdfDocument && hasPdfMetadata
        ? (metadataHasImageContent ? Math.Max(pdfMetadata!.DetectedImageCount, readableImageCount) : 0)
        : parsedDetectedImageCount;
    var imageTextHasUnreadableMessage = imageExtractedText.Contains(imageUnreadableMessage, StringComparison.OrdinalIgnoreCase);
    var hasReadableImageText = isPdfDocument && hasPdfMetadata
        ? metadataHasImageContent
        : hasImageTextSection
            && !string.IsNullOrWhiteSpace(cleanImageTextForDisplay)
            && !imageTextHasUnreadableMessage;
    var normalTextIsShort = isPdfDocument
        ? hasReadableImageText && !pdfHasEnoughRawText
        : hasImageTextSection && hasReadableImageText && normalUsefulWords < 80;
    var mainUsefulWords = CountUsefulWords($"{cleanNormalText} {cleanImageTextForDisplay}");
    var contentTypeLabel = (isUrlDocument, hasExtractedText, hasImageTextSection, normalUsefulWords < 80) switch
    {
        (true, true, _, _) => "Văn bản từ liên kết",
        (true, false, _, _) => "Chưa lấy được nội dung",
        (_, _, false, _) => "Văn bản",
        (_, _, true, true) => "Chủ yếu là hình ảnh",
        _ => "Văn bản + hình ảnh"
    };
    var mainContentSource = (isUrlDocument, hasExtractedText, hasImageTextSection, normalTextIsShort, hasReadableImageText && normalUsefulWords >= 80) switch
    {
        (true, true, _, _, _) => "Văn bản từ liên kết",
        (true, false, _, _, _) => "Liên kết URL",
        (_, _, false, _, _) => "Văn bản",
        (_, _, true, true, _) => "Hình ảnh",
        (_, _, true, _, true) => "Văn bản + hình ảnh",
        _ => "Văn bản"
    };
    if (isPdfDocument)
    {
        if (hasReadableImageText)
        {
            contentTypeLabel = pdfHasEnoughRawText
                ? "Văn bản + hình ảnh"
                : "Chủ yếu là hình ảnh";
            mainContentSource = pdfHasEnoughRawText
                ? "Văn bản + hình ảnh"
                : "Hình ảnh";
        }
        else
        {
            contentTypeLabel = "Văn bản";
            mainContentSource = "Văn bản";
            detectedImageCount = 0;
            readableImageCount = 0;
        }
    }

    var quizLearningText = $"{cleanNormalText} {cleanImageTextForDisplay}";
    var hasMathLearningSignals = HasEnoughMathLearningSignals(quizLearningText);
    var hasEnoughQuizContent = mainUsefulWords >= 80 || hasMathLearningSignals;
    var contentTypeHasImages = hasReadableImageText;
    var quizContentStatus = !hasEnoughQuizContent
        ? "Chưa đủ nội dung"
        : mainUsefulWords < 200
            ? "Đủ tạo quiz cơ bản"
            : "Đủ nội dung";
    var quizStatusClass = !hasEnoughQuizContent
        ? "danger"
        : mainUsefulWords < 200
            ? "warning"
            : "success";
    var usageSuggestionTitle = quizStatusClass switch
    {
        "danger" => "Cần bổ sung nội dung",
        "warning" => "Phù hợp tạo quiz cơ bản",
        _ => "Sẵn sàng tạo quiz"
    };
    var usageSuggestionText = quizStatusClass switch
    {
        "danger" => "Tài liệu hiện còn ít nội dung học tập. Bạn nên bổ sung thêm văn bản, dùng ảnh rõ chữ hơn hoặc nhập thêm nội dung bằng Paste Text để AI tạo đề chính xác hơn.",
        "warning" => "Tài liệu có thể tạo quiz ở mức cơ bản. Nên chọn số lượng câu hỏi vừa phải để tránh AI phải suy luận quá nhiều ngoài nội dung tài liệu.",
        _ => "Tài liệu có đủ nội dung để tạo quiz. Bạn có thể tạo bộ đề với số lượng câu hỏi nhiều hơn và phân bổ mức độ Bloom phù hợp."
    };
    var usageSuggestionHint = contentTypeHasImages
        ? "Với tài liệu dạng ảnh, hãy ưu tiên ảnh rõ nét, không bị cắt chữ và có đủ ngữ cảnh học tập."
        : "Với tài liệu dạng văn bản, nội dung càng rõ chủ đề thì câu hỏi AI tạo ra càng sát tài liệu.";
    var urlLooksLikePdf = isUrlDocument
        && !string.IsNullOrWhiteSpace(Model.SourceUrl)
        && Model.SourceUrl.Contains(".pdf", StringComparison.OrdinalIgnoreCase);
    var urlExtractionWarning = urlLooksLikePdf
        ? "Hiện tại hệ thống chưa trích xuất trực tiếp PDF từ URL. Bạn có thể tải PDF về và upload file PDF để AI đọc nội dung."
        : "Không lấy được nội dung học tập rõ ràng từ liên kết này. Bạn có thể mở link gốc, copy nội dung và dùng Paste Text hoặc upload file.";
    var emptyDocumentPreviewMessage = Model.SourceType == QuizGenAI.Models.DocumentSourceType.Word
        ? "Chưa trích xuất được nội dung văn bản hoặc nội dung ảnh từ tài liệu Word này."
        : "Chưa có nội dung xem trước cho tài liệu này.";
}

@functions {
    private sealed class PdfExtractionMetadata
    {
        public bool IsPresent { get; init; }
        public int PageCount { get; init; }
        public int RawTextLength { get; init; }
        public bool HasEnoughRawText { get; init; }
        public bool IsScanPdf { get; init; }
        public int TotalImageCount { get; init; }
        public int DetectedImageCount { get; init; }
        public int ProcessedImageCount { get; init; }
        public int RecognizedImageCount { get; init; }
        public bool HasImageContent { get; init; }
    }

    private static PdfExtractionMetadata? ParsePdfExtractionMetadata(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        var metadataText = ExtractPdfMetadataBlock(text);
        if (string.IsNullOrWhiteSpace(metadataText))
        {
            return null;
        }

        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        foreach (var line in metadataText.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries))
        {
            var separatorIndex = line.IndexOf('=', StringComparison.Ordinal);
            if (separatorIndex <= 0)
            {
                continue;
            }

            values[line[..separatorIndex].Trim()] = line[(separatorIndex + 1)..].Trim();
        }

        return new PdfExtractionMetadata
        {
            IsPresent = true,
            PageCount = GetMetadataInt(values, "PageCount"),
            RawTextLength = GetMetadataInt(values, "RawTextLength"),
            HasEnoughRawText = GetMetadataBool(values, "HasEnoughRawText"),
            IsScanPdf = GetMetadataBool(values, "IsScanPdf"),
            TotalImageCount = GetMetadataInt(values, "TotalImageCount"),
            DetectedImageCount = GetMetadataInt(values, "DetectedImageCount"),
            ProcessedImageCount = GetMetadataInt(values, "ProcessedImageCount"),
            RecognizedImageCount = GetMetadataInt(values, "RecognizedImageCount"),
            HasImageContent = GetMetadataBool(values, "HasImageContent")
        };
    }

    private static string RemovePdfMetadataBlock(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var start = text.IndexOf(QuizGenAI.Services.PdfExtractionService.MetadataSectionHeading, StringComparison.Ordinal);
        if (start < 0)
        {
            return text.Trim();
        }

        var end = text.IndexOf(
            QuizGenAI.Services.PdfExtractionService.MetadataSectionEndHeading,
            start,
            StringComparison.Ordinal);

        if (end < 0)
        {
            return text[..start].Trim();
        }

        end += QuizGenAI.Services.PdfExtractionService.MetadataSectionEndHeading.Length;

        return (text[..start] + text[end..]).Trim();
    }

    private static string? ExtractPdfMetadataBlock(string text)
    {
        var start = text.IndexOf(QuizGenAI.Services.PdfExtractionService.MetadataSectionHeading, StringComparison.Ordinal);
        if (start < 0)
        {
            return null;
        }

        start += QuizGenAI.Services.PdfExtractionService.MetadataSectionHeading.Length;

        var end = text.IndexOf(
            QuizGenAI.Services.PdfExtractionService.MetadataSectionEndHeading,
            start,
            StringComparison.Ordinal);

        if (end < 0)
        {
            return text[start..].Trim();
        }

        return text[start..end].Trim();
    }

    private static int GetMetadataInt(IReadOnlyDictionary<string, string> values, string key)
    {
        return values.TryGetValue(key, out var value) && int.TryParse(value, out var number)
            ? number
            : 0;
    }

    private static bool GetMetadataBool(IReadOnlyDictionary<string, string> values, string key)
    {
        return values.TryGetValue(key, out var value) && bool.TryParse(value, out var flag) && flag;
    }

    private static int CountUsefulWords(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return 0;
        }

        return System.Text.RegularExpressions.Regex.Matches(text, @"\b[\p{L}\p{N}]{2,}\b").Count;
    }

    private static bool HasEnoughMathLearningSignals(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return false;
        }

        var normalized = System.Text.RegularExpressions.Regex.Replace(text, @"\s+", " ").Trim();
        var compactLength = System.Text.RegularExpressions.Regex.Replace(normalized, @"\s+", string.Empty).Length;

        if (compactLength < 12)
        {
            return false;
        }

        var signalCount = 0;

        signalCount += System.Text.RegularExpressions.Regex.Matches(
            normalized,
            @"[\p{L}\p{N}]\s*[=+\-*/÷×]\s*[\p{L}\p{N}]",
            System.Text.RegularExpressions.RegexOptions.CultureInvariant).Count;

        signalCount += System.Text.RegularExpressions.Regex.Matches(
            normalized,
            @"\b\d+\s*/\s*\d+\b|\\frac\s*\{|[¼½¾⅓⅔⅕⅖⅗⅘⅙⅚⅛⅜⅝⅞]",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant).Count;

        signalCount += System.Text.RegularExpressions.Regex.Matches(
            normalized,
            @"\b(?:[\p{L}\p{N}]\s*\^\s*\d+|\d+\s*\^\s*[\p{L}\p{N}])|[⁰¹²³⁴⁵⁶⁷⁸⁹]",
            System.Text.RegularExpressions.RegexOptions.CultureInvariant).Count;

        signalCount += System.Text.RegularExpressions.Regex.Matches(
            normalized,
            @"√|\\sqrt|π|∞|≤|≥|≠|≈|∑|∫|∆|Δ|α|β|γ|θ|\b(?:sin|cos|tan|log|ln)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant).Count;

        return signalCount >= 3;
    }

    private static string CleanDocumentTextForCounting(
        string? text,
        string imageUnreadableMessage,
        string imageVisionTroubleshootingMessage)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return string.Empty;
        }

        var cleaned = text
            .Replace(QuizGenAI.Services.DocxExtractionService.NormalTextSectionHeading, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.DocxExtractionService.ImageTextSectionHeading, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.DocxExtractionService.WordTableStartMarker, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.DocxExtractionService.WordTableEndMarker, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.UrlExtractionService.UrlTableStartMarker, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.UrlExtractionService.UrlTableEndMarker, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.PdfExtractionService.NormalTextSectionHeading, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.PdfExtractionService.ImageTextSectionHeading, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.PdfExtractionService.ScannedPdfMessage, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(QuizGenAI.Services.PdfExtractionService.ImageUnreadableMessage, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(imageUnreadableMessage, " ", StringComparison.OrdinalIgnoreCase)
            .Replace(imageVisionTroubleshootingMessage, " ", StringComparison.OrdinalIgnoreCase)
            .Replace("KHONG_DOC_DUOC_NOI_DUNG_ANH", " ", StringComparison.OrdinalIgnoreCase);

        cleaned = RemovePdfMetadataBlock(cleaned);

        cleaned = System.Text.RegularExpressions.Regex.Replace(
            cleaned,
            @"(?:^|\r?\n)\s*Ghi chú(?: kỹ thuật)?:[^\r\n]*",
            " ",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

        cleaned = System.Text.RegularExpressions.Regex.Replace(
            cleaned,
            @"\(Không có nội dung văn bản thường được trích xuất từ Word\.\)",
            " ",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

        cleaned = System.Text.RegularExpressions.Regex.Replace(
            cleaned,
            @"\(KhÃ´ng cÃ³ ná»™i dung vÄƒn báº£n .*PDF\.\)",
            " ",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

        return cleaned.Trim();
    }

    private static string CleanImageTextForDisplay(
        string? imageText,
        string imageUnreadableMessage,
        string imageVisionTroubleshootingMessage)
    {
        var cleaned = CleanDocumentTextForCounting(
            imageText,
            imageUnreadableMessage,
            imageVisionTroubleshootingMessage);

        return string.IsNullOrWhiteSpace(cleaned)
            ? string.Empty
            : cleaned.Trim();
    }

    private static int CountReadableImageSections(string? imageText)
    {
        if (string.IsNullOrWhiteSpace(imageText))
        {
            return 0;
        }

        return System.Text.RegularExpressions.Regex.Matches(
            imageText,
            @"(?:^|\r?\n)\s*Ảnh\s+\d+\s*:",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant).Count;
    }

    private static int GetDetectedImageCount(string? imageText, int readableImageCount, bool hasImageTextSection)
    {
        if (!hasImageTextSection)
        {
            return 0;
        }

        if (!string.IsNullOrWhiteSpace(imageText))
        {
            var totalMatch = System.Text.RegularExpressions.Regex.Match(
                imageText,
                @"tài liệu có\s+(\d+)\s+ảnh",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

            if (totalMatch.Success && int.TryParse(totalMatch.Groups[1].Value, out var totalImages) && totalImages > 0)
            {
                return Math.Max(totalImages, readableImageCount);
            }

            var technicalMatch = System.Text.RegularExpressions.Regex.Match(
                imageText,
                @"đã gửi\s+(\d+)\s+ảnh cho AI;\s*bỏ qua\s+(\d+)\s+ảnh[^;]*;\s*(\d+)\s+ảnh lỗi",
                System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

            if (technicalMatch.Success &&
                int.TryParse(technicalMatch.Groups[1].Value, out var processed) &&
                int.TryParse(technicalMatch.Groups[2].Value, out var skipped) &&
                int.TryParse(technicalMatch.Groups[3].Value, out var failed))
            {
                return Math.Max(processed + skipped + failed, readableImageCount);
            }
        }

        return Math.Max(readableImageCount, 1);
    }

    private static Microsoft.AspNetCore.Html.IHtmlContent RenderReadableDocumentText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return new Microsoft.AspNetCore.Html.HtmlString(string.Empty);
        }

        var normalized = text
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Replace('\r', '\n')
            .Trim();
        var html = new System.Text.StringBuilder();
        var paragraphLines = new List<string>();
        var isInList = false;

        var lines = normalized.Split('\n');

        for (var lineIndex = 0; lineIndex < lines.Length; lineIndex++)
        {
            var line = lines[lineIndex].Trim();

            if (TryGetTableEndMarker(line, out var tableEndMarker))
            {
                AppendParagraphHtml(html, paragraphLines);
                paragraphLines.Clear();
                CloseListHtml(html, ref isInList);

                var tableRows = new List<IReadOnlyList<string>>();
                lineIndex++;

                while (lineIndex < lines.Length)
                {
                    var tableLine = lines[lineIndex].Trim();

                    if (tableLine.Equals(tableEndMarker, StringComparison.OrdinalIgnoreCase))
                    {
                        break;
                    }

                    if (TryGetWordTableRowCells(tableLine, out var cells))
                    {
                        tableRows.Add(cells);
                    }

                    lineIndex++;
                }

                AppendWordTableHtml(html, tableRows);
                continue;
            }

            if (string.IsNullOrWhiteSpace(line))
            {
                AppendParagraphHtml(html, paragraphLines);
                paragraphLines.Clear();
                CloseListHtml(html, ref isInList);
                continue;
            }

            if (TryGetListItemText(line, out var listItemText))
            {
                AppendParagraphHtml(html, paragraphLines);
                paragraphLines.Clear();

                if (!isInList)
                {
                    html.Append("<ul class=\"stitch-readable-list\">");
                    isInList = true;
                }

                html.Append("<li>");
                html.Append(System.Net.WebUtility.HtmlEncode(listItemText));
                html.Append("</li>");
                continue;
            }

            CloseListHtml(html, ref isInList);
            paragraphLines.Add(line);
        }

        AppendParagraphHtml(html, paragraphLines);
        CloseListHtml(html, ref isInList);

        return new Microsoft.AspNetCore.Html.HtmlString(html.ToString());
    }

    private static bool TryGetTableEndMarker(string line, out string tableEndMarker)
    {
        if (line.Equals(QuizGenAI.Services.DocxExtractionService.WordTableStartMarker, StringComparison.OrdinalIgnoreCase))
        {
            tableEndMarker = QuizGenAI.Services.DocxExtractionService.WordTableEndMarker;
            return true;
        }

        if (line.Equals(QuizGenAI.Services.UrlExtractionService.UrlTableStartMarker, StringComparison.OrdinalIgnoreCase))
        {
            tableEndMarker = QuizGenAI.Services.UrlExtractionService.UrlTableEndMarker;
            return true;
        }

        tableEndMarker = string.Empty;
        return false;
    }

    private static void AppendWordTableHtml(System.Text.StringBuilder html, IReadOnlyList<IReadOnlyList<string>> rows)
    {
        if (rows.Count == 0)
        {
            return;
        }

        var maxColumnCount = rows.Max(row => row.Count);
        if (maxColumnCount == 0)
        {
            return;
        }

        var hasHeader = IsLikelyHeaderRow(rows[0], rows.Skip(1));
        var bodyStartIndex = hasHeader ? 1 : 0;

        html.Append("<div class=\"stitch-word-table-wrap\"><table class=\"stitch-word-table\">");

        if (hasHeader)
        {
            html.Append("<thead><tr>");
            AppendTableCellsHtml(html, rows[0], maxColumnCount, "th");
            html.Append("</tr></thead>");
        }

        html.Append("<tbody>");

        for (var rowIndex = bodyStartIndex; rowIndex < rows.Count; rowIndex++)
        {
            html.Append("<tr>");
            AppendTableCellsHtml(html, rows[rowIndex], maxColumnCount, "td");
            html.Append("</tr>");
        }

        html.Append("</tbody></table></div>");
    }

    private static void AppendTableCellsHtml(
        System.Text.StringBuilder html,
        IReadOnlyList<string> cells,
        int maxColumnCount,
        string cellTagName)
    {
        for (var columnIndex = 0; columnIndex < maxColumnCount; columnIndex++)
        {
            var cellText = columnIndex < cells.Count
                ? cells[columnIndex]
                : string.Empty;

            html.Append('<');
            html.Append(cellTagName);
            html.Append('>');
            html.Append(System.Net.WebUtility.HtmlEncode(cellText));
            html.Append("</");
            html.Append(cellTagName);
            html.Append('>');
        }
    }

    private static bool IsLikelyHeaderRow(IReadOnlyList<string> firstRow, IEnumerable<IReadOnlyList<string>> remainingRows)
    {
        if (firstRow.Count == 0 || firstRow.All(string.IsNullOrWhiteSpace))
        {
            return false;
        }

        var firstRowText = string.Join(" ", firstRow).Trim();
        var headerKeywordCount = System.Text.RegularExpressions.Regex.Matches(
            firstRowText,
            @"\b(?:STT|Mã|Ma|Tên|Ten|Học|Hoc|phần|phan|Số|So|tín|tin|chỉ|chi|Môn|Mon|Kỳ|Ky|Loại|Loai|Ghi chú|Ghi chu)\b",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant).Count;

        if (headerKeywordCount >= 2)
        {
            return true;
        }

        var firstRowHasLetters = firstRow.Any(cell => System.Text.RegularExpressions.Regex.IsMatch(cell, @"\p{L}"));
        var laterRowsLookDataLike = remainingRows
            .Take(3)
            .Any(row => row.Any(cell => System.Text.RegularExpressions.Regex.IsMatch(cell, @"\d")));

        return firstRowHasLetters && laterRowsLookDataLike;
    }

    private static bool TryGetWordTableRowCells(string line, out IReadOnlyList<string> cells)
    {
        cells = Array.Empty<string>();

        if (string.IsNullOrWhiteSpace(line) || !line.StartsWith('|') || !line.EndsWith('|'))
        {
            return false;
        }

        var parsedCells = line
            .Trim('|')
            .Split('|')
            .Select(cell => cell.Trim())
            .ToList();

        if (parsedCells.Count == 0 || parsedCells.All(string.IsNullOrWhiteSpace))
        {
            return false;
        }

        cells = parsedCells;
        return true;
    }

    private static void AppendParagraphHtml(System.Text.StringBuilder html, IReadOnlyList<string> paragraphLines)
    {
        if (paragraphLines.Count == 0)
        {
            return;
        }

        html.Append("<p>");

        for (var index = 0; index < paragraphLines.Count; index++)
        {
            if (index > 0)
            {
                html.Append("<br />");
            }

            html.Append(System.Net.WebUtility.HtmlEncode(paragraphLines[index]));
        }

        html.Append("</p>");
    }

    private static void CloseListHtml(System.Text.StringBuilder html, ref bool isInList)
    {
        if (!isInList)
        {
            return;
        }

        html.Append("</ul>");
        isInList = false;
    }

    private static bool TryGetListItemText(string line, out string listItemText)
    {
        var match = System.Text.RegularExpressions.Regex.Match(
            line,
            @"^\s*(?:[-*]\s+|\u2022\s+|\d+[\.)]\s+)(.+)$",
            System.Text.RegularExpressions.RegexOptions.CultureInvariant);

        listItemText = match.Success
            ? match.Groups[1].Value.Trim()
            : string.Empty;

        return !string.IsNullOrWhiteSpace(listItemText);
    }
}

