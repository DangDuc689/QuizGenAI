<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuizGen AI</title>
    
    <!-- Fonts & Icons from design -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS with custom configuration -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              "colors": {
                      "slate-200": "#E2E8F0",
                      "primary-fixed-dim": "#b7c4ff",
                      "on-secondary-fixed": "#0d1c2f",
                      "on-tertiary-fixed-variant": "#5a00c6",
                      "surface-bright": "#faf8ff",
                      "on-tertiary-container": "#dfccff",
                      "tertiary": "#5700c0",
                      "tertiary-fixed": "#eaddff",
                      "on-secondary": "#ffffff",
                      "surface-container-high": "#e2e7ff",
                      "on-tertiary": "#ffffff",
                      "surface-container-low": "#f2f3ff",
                      "slate-100": "#F1F5F9",
                      "inverse-surface": "#283044",
                      "slate-300": "#CBD5E1",
                      "outline": "#747686",
                      "on-primary": "#ffffff",
                      "warning": "#D97706",
                      "surface-variant": "#dae2fd",
                      "inverse-primary": "#b7c4ff",
                      "danger": "#DC2626",
                      "success": "#16A34A",
                      "on-secondary-container": "#57657b",
                      "danger-light": "#FEE2E2",
                      "primary-fixed": "#dce1ff",
                      "surface-container-lowest": "#ffffff",
                      "slate-50": "#F8FAFC",
                      "secondary": "#515f74",
                      "tertiary-container": "#712ae2",
                      "success-light": "#DCFCE7",
                      "on-error-container": "#93000a",
                      "on-primary-fixed-variant": "#0039b5",
                      "on-tertiary-fixed": "#25005a",
                      "bloom-apply": "#EA580C",
                      "error": "#ba1a1a",
                      "surface-container": "#eaedff",
                      "surface-container-highest": "#dae2fd",
                      "surface-tint": "#2151da",
                      "warning-light": "#FEF3C7",
                      "secondary-fixed-dim": "#b9c7e0",
                      "tertiary-fixed-dim": "#d2bbff",
                      "slate-400": "#94A3B8",
                      "primary-container": "#1d4ed8",
                      "on-primary-fixed": "#001551",
                      "surface": "#faf8ff",
                      "on-error": "#ffffff",
                      "surface-dim": "#d2d9f4",
                      "on-background": "#131b2e",
                      "bloom-remember": "#1D4ED8",
                      "on-surface-variant": "#434655",
                      "bloom-understand": "#7C3AED",
                      "secondary-fixed": "#d5e3fd",
                      "error-container": "#ffdad6",
                      "primary": "#0037b0",
                      "on-secondary-fixed-variant": "#3a485c",
                      "inverse-on-surface": "#eef0ff",
                      "outline-variant": "#c4c5d7",
                      "background": "#faf8ff",
                      "on-primary-container": "#cad3ff",
                      "on-surface": "#131b2e",
                      "secondary-container": "#d5e3fd"
              },
              "borderRadius": {
                      "DEFAULT": "0.25rem",
                      "lg": "0.5rem",
                      "xl": "0.75rem",
                      "full": "9999px"
              },
              "spacing": {
                      "sidebar-width": "240px",
                      "gutter": "24px",
                      "base": "4px",
                      "margin-desktop": "120px",
                      "max-width": "1200px"
              },
              "fontFamily": {
                      "label-sm": ["Inter"],
                      "body": ["Inter"],
                      "button": ["Inter"],
                      "h3": ["Inter"],
                      "h1": ["Inter"],
                      "h2": ["Inter"],
                      "caption": ["Inter"]
              },
              "fontSize": {
                      "label-sm": [
                              "11px",
                              {
                                      "lineHeight": "1",
                                      "letterSpacing": "0.05em",
                                      "fontWeight": "700"
                              }
                      ],
                      "body": [
                              "14px",
                              {
                                      "lineHeight": "1.5",
                                      "fontWeight": "400"
                              }
                      ],
                      "button": [
                              "14px",
                              {
                                      "lineHeight": "1",
                                      "fontWeight": "600"
                              }
                      ],
                      "h3": [
                              "18px",
                              {
                                      "lineHeight": "1.4",
                                      "fontWeight": "600"
                              }
                      ],
                      "h1": [
                              "32px",
                              {
                                      "lineHeight": "1.2",
                                      "fontWeight": "700"
                              }
                      ],
                      "h2": [
                              "24px",
                              {
                                      "lineHeight": "1.3",
                                      "fontWeight": "600"
                              }
                      ],
                      "caption": [
                              "12px",
                              {
                                      "lineHeight": "1.4",
                                      "fontWeight": "400"
                              }
                      ]
              }
            },
          },
        }
    </script>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-slate-50 dark:bg-on-background text-on-surface dark:text-on-primary-container font-body min-h-screen flex flex-col md:flex-row">

    <!-- Partial Sidebar dùng chung -->
    <partial name="_Sidebar" />

    <!-- Vùng nội dung chính bên phải -->
    <div class="flex-1 md:ml-[240px] flex flex-col min-h-screen">
        
        <!-- Partial Header dùng chung -->
        <partial name="_Header" />

        <!-- Phần hiển thị nội dung trang con -->
        <main role="main" class="flex-1 p-6 md:p-8 max-w-max-width mx-auto w-full">
            @RenderBody()
        </main>
        
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
