@using Microsoft.AspNetCore.Identity
@using QuizGenAI.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = SignInManager.IsSignedIn(User)
        ? await UserManager.GetUserAsync(User)
        : null;
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "Tài khoản";
    var avatarSource = currentUser?.FullName ?? currentUser?.Email ?? "Q";
    var avatarInitial = string.IsNullOrWhiteSpace(avatarSource)
        ? "Q"
        : avatarSource.Trim()[0].ToString().ToUpperInvariant();
}

<header class="bg-surface dark:bg-on-secondary-fixed border-b border-slate-200 dark:border-outline-variant w-full top-0 sticky z-30 h-16 px-6 flex justify-between items-center shadow-sm">
    <div class="flex items-center gap-4">
        <button id="sidebar-toggle" class="md:hidden text-on-surface-variant hover:bg-slate-100 dark:hover:bg-secondary-container p-2 rounded-full transition-transform active:scale-95 flex items-center justify-center">
            <span class="material-symbols-outlined">menu</span>
        </button>

        <div class="hidden sm:flex bg-slate-100 dark:bg-surface-container rounded-full px-4 py-2 items-center gap-2 border border-slate-200 dark:border-outline-variant focus-within:border-primary dark:focus-within:border-primary-fixed-dim transition-colors w-64 shadow-inner">
            <span class="material-symbols-outlined text-outline" style="font-size: 20px;">search</span>
            <input class="bg-transparent border-none outline-none text-body font-body text-on-surface w-full focus:ring-0 p-0 placeholder-slate-400" placeholder="Tìm kiếm..." type="text">
        </div>
    </div>

    <div class="flex items-center gap-2">
        <button id="dark-mode-toggle" class="text-on-surface-variant hover:bg-slate-100 dark:hover:bg-secondary-container rounded-full p-2 active:scale-95 transition-transform flex items-center justify-center cursor-pointer" title="Chuyển chế độ sáng/tối">
            <span class="material-symbols-outlined" id="dark-mode-icon">dark_mode</span>
        </button>

        <button class="text-on-surface-variant hover:bg-slate-100 dark:hover:bg-secondary-container rounded-full p-2 active:scale-95 transition-transform flex items-center justify-center relative cursor-pointer" title="Thông báo">
            <span class="material-symbols-outlined">notifications</span>
            <span class="absolute top-2 right-2 w-2 h-2 bg-danger rounded-full ring-2 ring-white dark:ring-on-secondary-fixed"></span>
        </button>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="ml-4 pl-4 border-l border-slate-200 dark:border-outline-variant flex items-center gap-3">
                @if (User.IsInRole(SD.Role_Admin))
                {
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="hidden md:inline-flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-2 text-sm font-bold text-primary hover:bg-slate-200">
                        <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
                        Admin
                    </a>
                }
                <div class="hidden sm:block text-right">
                    <p class="text-sm font-bold text-on-surface leading-tight">@displayName</p>
                    <p class="text-[11px] text-secondary leading-tight">Đã đăng nhập</p>
                </div>
                <div class="w-8 h-8 rounded-full bg-primary text-on-primary border border-slate-200 dark:border-outline-variant flex items-center justify-center shadow-sm font-bold">
                    @avatarInitial
                </div>
                <form asp-area="" asp-controller="Login" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="text-on-surface-variant hover:bg-slate-100 dark:hover:bg-secondary-container rounded-full p-2 active:scale-95 transition-transform flex items-center justify-center cursor-pointer" title="Đăng xuất">
                        <span class="material-symbols-outlined">logout</span>
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="ml-4 pl-4 border-l border-slate-200 dark:border-outline-variant flex items-center gap-2">
                <a asp-area="" asp-controller="Login" asp-action="Index" class="px-3 py-2 rounded-lg text-sm font-bold text-primary hover:bg-slate-100 transition-colors">Đăng nhập</a>
                <a asp-area="" asp-controller="Register" asp-action="Index" class="px-3 py-2 rounded-lg text-sm font-bold text-white bg-primary hover:bg-primary-container transition-colors">Đăng ký</a>
            </div>
        }
    </div>
</header>
