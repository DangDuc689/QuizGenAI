<!-- TopNavBar -->
<header class="bg-surface dark:bg-on-secondary-fixed border-b border-slate-200 dark:border-outline-variant w-full top-0 sticky z-30 h-16 px-6 flex justify-between items-center shadow-sm">
    
    <!-- Left side: Mobile Hamburger & Search -->
    <div class="flex items-center gap-4">
        
        <!-- Mobile Menu Button (Hamburger) -->
        <button id="sidebar-toggle" class="md:hidden text-on-surface-variant hover:bg-slate-100 dark:hover:bg-secondary-container p-2 rounded-full transition-transform active:scale-95 flex items-center justify-center">
            <span class="material-symbols-outlined">menu</span>
        </button>
        
        <!-- Desktop Search Bar -->
        <div class="hidden sm:flex bg-slate-100 dark:bg-surface-container rounded-full px-4 py-2 items-center gap-2 border border-slate-200 dark:border-outline-variant focus-within:border-primary dark:focus-within:border-primary-fixed-dim transition-colors w-64 shadow-inner">
            <span class="material-symbols-outlined text-outline" style="font-size: 20px;">search</span>
            <input class="bg-transparent border-none outline-none text-body font-body text-on-surface w-full focus:ring-0 p-0 placeholder-slate-400" placeholder="Tìm kiếm..." type="text">
        </div>
        
    </div>
    
    <!-- Right side: Notifications, Dark mode, User profile -->
    <div class="flex items-center gap-2">
        
        <!-- Dark Mode Toggle Button -->
        <button id="dark-mode-toggle" class="text-on-surface-variant hover:bg-slate-100 dark:hover:bg-secondary-container rounded-full p-2 active:scale-95 transition-transform flex items-center justify-center cursor-pointer" title="Chuyển chế độ sáng/tối">
            <!-- Icon will be dynamic based on JS state (dark_mode or light_mode) -->
            <span class="material-symbols-outlined" id="dark-mode-icon">dark_mode</span>
        </button>
        
        <!-- Notifications button with red badge -->
        <button class="text-on-surface-variant hover:bg-slate-100 dark:hover:bg-secondary-container rounded-full p-2 active:scale-95 transition-transform flex items-center justify-center relative cursor-pointer" title="Thông báo">
            <span class="material-symbols-outlined">notifications</span>
            <span class="absolute top-2 right-2 w-2 h-2 bg-danger rounded-full ring-2 ring-white dark:ring-on-secondary-fixed"></span>
        </button>
        <!-- User Profile / Auth State -->
        @using System.Security.Claims
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="ml-4 pl-4 border-l border-slate-200 dark:border-outline-variant flex items-center gap-3 relative group">
                <div class="flex flex-col text-right hidden md:flex">
                    <span class="text-xs font-semibold text-on-surface dark:text-on-primary-container truncate max-w-[120px]">@User.Identity.Name</span>
                    <span class="text-[10px] text-slate-400">Thành viên</span>
                </div>
                <img alt="User Avatar" class="w-8 h-8 rounded-full border border-slate-200 dark:border-outline-variant cursor-pointer object-cover shadow-sm transition-all duration-200" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCaiTHZMv26jPfF1m6XzNT09HCTTfgcy4QchmzeZi448IJZcDoOEcKyDMwyw7GexPyfBVNo2qFVYVCcXI9ipF74rpDYre5ZuL2aacXnznuPVIOBJsNMDtP-XTFtGpWj-VxguOy2_MrQTBL5ER6PxkHZKzeeJpm6g7OSzaXIXsk3Nco4hLuWu85jhz2fDwK5psviN-opBxHQdL_PEHK38FIMRoWLnnbbaJyrvEJtluzNndKyQyzDlNoivhDlHHhkh6XupXH0WtfsyII">
                
                <!-- Dropdown Menu (Hover Triggered) -->
                <div class="absolute right-0 top-8 pt-4 w-48 rounded-xl bg-white dark:bg-on-secondary-fixed border border-slate-100 dark:border-outline-variant shadow-lg hidden group-hover:block z-50">
                    <div class="p-4 border-b border-slate-100 dark:border-outline-variant text-left">
                        <span class="block text-xs font-semibold text-on-surface dark:text-on-primary-container truncate">@User.Identity.Name</span>
                        <span class="block text-[10px] text-slate-400 mt-0.5">Tài khoản cá nhân</span>
                    </div>
                    <div class="p-2">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full text-left px-3 py-2 text-xs text-red-600 hover:bg-red-50 dark:hover:bg-red-950/20 rounded-lg flex items-center gap-2 transition-colors cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">logout</span>
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="ml-4 pl-4 border-l border-slate-200 dark:border-outline-variant flex items-center gap-2">
                <a asp-controller="Account" asp-action="Login" class="px-4 py-2 border border-slate-200 dark:border-outline-variant text-slate-700 dark:text-secondary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant rounded-xl font-button text-xs transition-colors">
                    Đăng nhập
                </a>
                <a asp-controller="Account" asp-action="Register" class="px-4 py-2 bg-primary text-white hover:bg-primary-dark rounded-xl font-button text-xs transition-colors shadow-sm">
                    Đăng ký
                </a>
            </div>
        }
        
    </div>
    
</header>
