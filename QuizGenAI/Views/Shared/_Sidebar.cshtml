@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var activePage = ViewData["ActivePage"]?.ToString() ?? "";

    // Tự động nhận diện trang hoạt động dựa trên Controller/Action nếu chưa được chỉ định tường minh
    if (string.IsNullOrEmpty(activePage))
    {
        if ((controller == "Home" || controller == "Dashboard") && action == "Index")
        {
            activePage = "Dashboard";
        }
        else if (controller == "Home" && action == "Privacy")
        {
            activePage = "Privacy";
        }
        else if (controller == "Exam" && action == "Review")
        {
            activePage = "Review";
        }
        else if (controller == "Exam" && action == "History")
        {
            activePage = "History";
        }
        else if (controller == "Explore")
        {
            activePage = "Explore";
        }
        else
        {
            activePage = "Review"; // Mặc định hiển thị Ôn tập nếu ở trang khác
        }
    }
}

<!-- Mobile Sidebar Backdrop Overlay -->
<div id="sidebar-overlay" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-30 hidden transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<!-- SideNavBar -->
<nav id="sidebar" class="fixed left-0 top-0 h-screen w-sidebar-width bg-surface dark:bg-on-secondary-fixed border-r border-slate-200 dark:border-outline-variant z-40 flex flex-col py-6 transition-transform duration-300 -translate-x-full md:translate-x-0">
    
    <!-- Logo area -->
    <div class="px-6 mb-8 flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center shadow-sm">
            <span class="material-symbols-outlined text-on-primary" style="font-size: 20px;">school</span>
        </div>
        <div>
            <h2 class="text-h3 font-h3 text-primary dark:text-primary-fixed-dim tracking-tight">QuizGen AI</h2>
            <p class="text-caption font-caption text-secondary">Academic Excellence</p>
        </div>
    </div>
    
    <!-- Menu items list -->
    <ul class="flex-1 space-y-1 mt-4">
        
        <!-- Dashboard -->
        <li>
            <a asp-controller="Dashboard" asp-action="Index" 
               class="flex items-center px-6 py-3 border-l-4 transition-all duration-200 gap-3 group @(activePage == "Dashboard" ? "bg-surface-container-low dark:bg-secondary-container text-primary dark:text-on-primary-container border-primary dark:border-primary-fixed-dim" : "text-secondary dark:text-secondary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant border-transparent")">
                <span class="material-symbols-outlined" style="@(activePage == "Dashboard" ? "font-variation-settings: 'FILL' 1;" : "")">dashboard</span>
                <span class="font-label-sm text-label-sm">Dashboard</span>
            </a>
        </li>
        
        <!-- Tài liệu -->
        <li>
            <a asp-controller="Documents" asp-action="Index"
               class="flex items-center px-6 py-3 border-l-4 transition-all duration-200 gap-3 group @(activePage == "Documents" ? "bg-surface-container-low dark:bg-secondary-container text-primary dark:text-on-primary-container border-primary" : "text-secondary dark:text-secondary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant border-transparent")">
                <span class="material-symbols-outlined" style="@(activePage == "Documents" ? "font-variation-settings: 'FILL' 1;" : "")">description</span>
                <span class="font-label-sm text-label-sm">Tài liệu</span>
            </a>
        </li>
        
        <!-- Ôn tập -->
        <li>
            <a asp-controller="Exam" asp-action="Review" 
               class="flex items-center px-6 py-3 border-l-4 transition-all duration-200 gap-3 group @(activePage == "Review" ? "bg-surface-container-low dark:bg-secondary-container text-primary dark:text-on-primary-container border-primary dark:border-primary-fixed-dim" : "text-secondary dark:text-secondary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant border-transparent")">
                <span class="material-symbols-outlined" style="@(activePage == "Review" ? "font-variation-settings: 'FILL' 1;" : "")">auto_stories</span>
                <span class="font-label-sm text-label-sm">Ôn tập</span>
            </a>
        </li>
        
        <!-- Khám phá -->
        <li>
            <a asp-controller="Explore" asp-action="Index" 
               class="flex items-center px-6 py-3 border-l-4 transition-all duration-200 gap-3 group @(activePage == "Explore" ? "bg-surface-container-low dark:bg-secondary-container text-primary border-primary" : "text-secondary dark:text-secondary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant border-transparent")">
                <span class="material-symbols-outlined" style="@(activePage == "Explore" ? "font-variation-settings: 'FILL' 1;" : "")">explore</span>
                <span class="font-label-sm text-label-sm">Khám phá</span>
            </a>
        </li>
        
        <!-- Phân tích (Đã gộp vào Dashboard) -->
        <!-- 
        <li>
            <a href="#" 
               class="flex items-center px-6 py-3 border-l-4 transition-all duration-200 gap-3 group @(activePage == "Analytics" ? "bg-surface-container-low dark:bg-secondary-container text-primary border-primary" : "text-secondary dark:text-secondary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant border-transparent")">
                <span class="material-symbols-outlined" style="@(activePage == "Analytics" ? "font-variation-settings: 'FILL' 1;" : "")">analytics</span>
                <span class="font-label-sm text-label-sm">Phân tích</span>
            </a>
        </li>
        -->
        
        <!-- Lịch sử -->
        <li>
            <a asp-controller="Exam" asp-action="History"
               class="flex items-center px-6 py-3 border-l-4 transition-all duration-200 gap-3 group @(activePage == "History" ? "bg-surface-container-low dark:bg-secondary-container text-primary border-primary" : "text-secondary dark:text-secondary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant border-transparent")">
                <span class="material-symbols-outlined" style="@(activePage == "History" ? "font-variation-settings: 'FILL' 1;" : "")">history</span>
                <span class="font-label-sm text-label-sm">Lịch sử</span>
            </a>
        </li>
        
    </ul>
    
    <!-- Settings section (Pinned to bottom) -->
    <div class="mt-auto px-6 py-4 border-t border-slate-200 dark:border-outline-variant">
        <a href="#" 
           class="flex items-center py-2 text-secondary dark:text-secondary-fixed-dim hover:text-primary dark:hover:text-primary-fixed-dim transition-colors gap-3 group">
            <span class="material-symbols-outlined group-hover:rotate-45 transition-transform duration-300">settings</span>
            <span class="font-label-sm text-label-sm">Cài đặt</span>
        </a>
    </div>
    
</nav>
