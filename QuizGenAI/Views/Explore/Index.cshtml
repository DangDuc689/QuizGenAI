@{
    ViewData["Title"] = "Khám phá";
    ViewData["ActivePage"] = "Explore";
}

<!-- Page Title & Search/Filter Section -->
<div class="mb-8">
    <h1 class="text-h1 font-h1 text-on-surface dark:text-on-primary-container mb-2">Khám phá</h1>
    <p class="font-body text-body text-secondary dark:text-secondary-fixed-dim mb-6">Tìm kiếm hàng ngàn bộ đề được tạo bởi cộng đồng QuizGen AI.</p>
    <div class="flex flex-col md:flex-row gap-4">
        <div class="relative flex-1 md:hidden">
            <span class="material-symbols-outlined absolute left-3 top-1/2 transform -translate-y-1/2 text-outline" data-icon="search">search</span>
            <input class="w-full pl-10 pr-4 py-2 bg-surface dark:bg-on-secondary-fixed border border-slate-200 dark:border-outline-variant rounded-lg focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-body text-body text-on-surface dark:text-on-primary-container placeholder-outline transition-shadow" placeholder="Tìm kiếm bộ đề..." type="text">
        </div>
        <div class="flex space-x-2 overflow-x-auto no-scrollbar pb-2 md:pb-0">
            <button class="px-4 py-2 bg-primary text-on-primary rounded-lg font-button text-button whitespace-nowrap shadow-sm hover:bg-primary/90 transition-colors">Tất cả</button>
            <button class="px-4 py-2 bg-surface dark:bg-on-secondary-fixed text-secondary dark:text-secondary-fixed-dim border border-slate-200 dark:border-outline-variant rounded-lg font-button text-button whitespace-nowrap hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant transition-colors">Toán học</button>
            <button class="px-4 py-2 bg-surface dark:bg-on-secondary-fixed text-secondary dark:text-secondary-fixed-dim border border-slate-200 dark:border-outline-variant rounded-lg font-button text-button whitespace-nowrap hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant transition-colors">Vật lý</button>
            <button class="px-4 py-2 bg-surface dark:bg-on-secondary-fixed text-secondary dark:text-secondary-fixed-dim border border-slate-200 dark:border-outline-variant rounded-lg font-button text-button whitespace-nowrap hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant transition-colors">Hóa học</button>
            <button class="px-4 py-2 bg-surface dark:bg-on-secondary-fixed text-secondary dark:text-secondary-fixed-dim border border-slate-200 dark:border-outline-variant rounded-lg font-button text-button whitespace-nowrap hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant transition-colors">Sinh học</button>
            <button class="px-4 py-2 bg-surface dark:bg-on-secondary-fixed text-secondary dark:text-secondary-fixed-dim border border-slate-200 dark:border-outline-variant rounded-lg font-button text-button whitespace-nowrap hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant transition-colors flex items-center">
                <span class="material-symbols-outlined text-[18px] mr-1" data-icon="filter_list">filter_list</span> Lọc
            </button>
        </div>
    </div>
</div>

