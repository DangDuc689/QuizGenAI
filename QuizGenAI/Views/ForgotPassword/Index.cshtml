@model QuizGenAI.Controllers.ForgotPasswordController.InputModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu";
}

<main class="auth-shell auth-shell-forgot">
    <section class="auth-card auth-card-forgot" aria-labelledby="forgot-title">
        <div class="auth-card-brand">
            <a asp-controller="Home" asp-action="Index">QuizGen AI</a>
            <p>Academic Excellence</p>
        </div>

        <div class="auth-panel-heading">
            <h1 id="forgot-title">Quên mật khẩu</h1>
            <p>Nhập email tài khoản của bạn để nhận liên kết đặt lại mật khẩu.</p>
        </div>

        <form asp-controller="ForgotPassword" asp-action="Index" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <span class="material-symbols-outlined auth-input-icon">mail</span>
                    <input asp-for="Email" class="auth-input has-leading-icon" autocomplete="username" placeholder="name@university.edu" />
                </div>
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>

            <button type="submit" class="auth-primary-button">
                Gửi liên kết
                <span class="material-symbols-outlined">arrow_forward</span>
            </button>
        </form>

        <footer class="auth-card-footer">
            Nhớ mật khẩu rồi?
            <a href="/Identity/Account/Login">Quay lại đăng nhập</a>
        </footer>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
