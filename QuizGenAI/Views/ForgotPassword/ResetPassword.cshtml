@model QuizGenAI.Controllers.ForgotPasswordController.ResetInputModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<main class="auth-shell auth-shell-forgot">
    <section class="auth-card auth-card-forgot" aria-labelledby="reset-title">
        <div class="auth-card-brand">
            <a asp-controller="Home" asp-action="Index">QuizGen AI</a>
            <p>Academic Excellence</p>
        </div>

        <div class="auth-panel-heading">
            <h1 id="reset-title">Đặt lại mật khẩu</h1>
            <p>Tạo mật khẩu mới cho tài khoản của bạn.</p>
        </div>

        <form asp-controller="ForgotPassword" asp-action="ResetPassword" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" autocomplete="username" readonly />
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" id="reset-password" class="auth-input has-trailing-icon" autocomplete="new-password" placeholder="Nhập mật khẩu mới" />
                    <button class="auth-icon-button" type="button" data-password-toggle="#reset-password" aria-label="Hiện hoặc ẩn mật khẩu">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <input asp-for="ConfirmPassword" id="reset-confirm-password" class="auth-input has-trailing-icon" autocomplete="new-password" placeholder="Nhập lại mật khẩu mới" />
                    <button class="auth-icon-button" type="button" data-password-toggle="#reset-confirm-password" aria-label="Hiện hoặc ẩn mật khẩu">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
            </div>

            <button type="submit" class="auth-primary-button">Cập nhật mật khẩu</button>
        </form>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
