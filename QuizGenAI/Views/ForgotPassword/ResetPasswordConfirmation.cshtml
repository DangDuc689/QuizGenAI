@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đã đặt lại mật khẩu";
}

<main class="auth-shell auth-shell-forgot">
    <section class="auth-card auth-card-forgot">
        <div class="auth-card-brand">
            <a asp-controller="Home" asp-action="Index">QuizGen AI</a>
            <p>Academic Excellence</p>
        </div>

        <div class="auth-status-icon success">
            <span class="material-symbols-outlined">check_circle</span>
        </div>

        <div class="auth-panel-heading centered">
            <h1>Mật khẩu đã được cập nhật</h1>
            <p>Bạn có thể đăng nhập lại bằng mật khẩu mới.</p>
        </div>

        <a class="auth-primary-button as-link" asp-controller="Login" asp-action="Index">Đăng nhập ngay</a>
    </section>
</main>
