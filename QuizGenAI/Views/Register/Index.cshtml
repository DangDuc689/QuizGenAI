@model QuizGenAI.Controllers.RegisterController.InputModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng ký";
}

<main class="auth-shell auth-shell-register">
    <section class="auth-card auth-card-register" aria-labelledby="register-title">
        <div class="auth-card-brand">
            <a asp-controller="Home" asp-action="Index">QuizGen AI</a>
            <p>Academic Excellence</p>
        </div>

        <div class="auth-tabs">
            <a class="auth-tab" asp-controller="Login" asp-action="Index">Đăng nhập</a>
            <a class="auth-tab active" asp-controller="Register" asp-action="Index">Đăng ký</a>
        </div>

        <form asp-controller="Register" asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form" novalidate>
            @Html.AntiForgeryToken()
            <h1 id="register-title" class="sr-only">Đăng ký QuizGen AI</h1>
            <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

            <div class="auth-field">
                <label asp-for="FullName" class="auth-label"></label>
                <input asp-for="FullName" class="auth-input" autocomplete="name" placeholder="Nhập họ và tên của bạn" />
                <span asp-validation-for="FullName" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Email" class="auth-label"></label>
                <input asp-for="Email" class="auth-input" autocomplete="username" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <input asp-for="Password" id="register-password" class="auth-input has-trailing-icon" autocomplete="new-password" placeholder="Tạo mật khẩu" />
                    <button class="auth-icon-button" type="button" data-password-toggle="#register-password" aria-label="Hiện hoặc ẩn mật khẩu">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="Password" class="auth-error"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword" class="auth-label"></label>
                <div class="auth-input-wrap">
                    <input asp-for="ConfirmPassword" id="register-confirm-password" class="auth-input has-trailing-icon" autocomplete="new-password" placeholder="Nhập lại mật khẩu" />
                    <button class="auth-icon-button" type="button" data-password-toggle="#register-confirm-password" aria-label="Hiện hoặc ẩn mật khẩu">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="auth-error"></span>
            </div>

            <label class="auth-checkline">
                <input asp-for="AcceptTerms" class="auth-checkbox" />
                <span>Tôi đồng ý với <a href="#">Điều khoản</a> và <a href="#">Chính sách bảo mật</a></span>
            </label>
            <span asp-validation-for="AcceptTerms" class="auth-error"></span>

            <button type="submit" class="auth-primary-button">Đăng ký ngay</button>

            <div class="auth-divider"><span>hoặc</span></div>

            <div class="auth-social-row">
                <button type="button" class="auth-social-button" disabled>
                    <span class="auth-social-mark">G</span>
                    Google
                </button>
                <button type="button" class="auth-social-button" disabled>
                    <span class="auth-social-mark">M</span>
                    Microsoft
                </button>
            </div>
        </form>

        <footer class="auth-card-footer">
            Đã có tài khoản?
            <a asp-controller="Login" asp-action="Index">Đăng nhập ngay</a>
        </footer>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
