@{
    ViewData["Title"] = "Tạo bộ câu hỏi ôn tập";
}

<!-- Header & Stepper -->
<div class="mb-8">
    <h1 class="text-h1 font-h1 text-on-surface dark:text-primary-fixed-dim mb-2 tracking-tight">Tạo bộ câu hỏi ôn tập</h1>
    <p class="text-body font-body text-secondary dark:text-secondary-fixed-dim">Cung cấp nội dung để AI tự động trích xuất và tạo câu hỏi.</p>
    
    <!-- Stepper (Responsive) -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 mt-8">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-button text-button shadow-sm">1</div>
            <span class="font-button text-button text-primary dark:text-primary-fixed-dim">Nhập nội dung</span>
        </div>
        <div class="hidden sm:block h-px w-12 bg-slate-300 dark:bg-outline-variant"></div>
        <div class="flex items-center gap-2 opacity-50">
            <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-on-secondary-fixed-variant text-secondary dark:text-secondary-fixed-dim flex items-center justify-center font-button text-button">2</div>
            <span class="font-button text-button text-secondary dark:text-secondary-fixed-dim">Cấu hình</span>
        </div>
        <div class="hidden sm:block h-px w-12 bg-slate-300 dark:bg-outline-variant"></div>
        <div class="flex items-center gap-2 opacity-50">
            <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-on-secondary-fixed-variant text-secondary dark:text-secondary-fixed-dim flex items-center justify-center font-button text-button">3</div>
            <span class="font-button text-button text-secondary dark:text-secondary-fixed-dim">Hoàn thành</span>
        </div>
    </div>
</div>

<!-- Main Interactive Area -->
<div class="bg-surface dark:bg-on-secondary-fixed rounded-xl border border-slate-200 dark:border-outline-variant overflow-hidden mb-6 soft-shadow">
    <!-- Tabs (Responsive flex) -->
    <div class="flex flex-col sm:flex-row border-b border-slate-200 dark:border-outline-variant">
        <button class="flex-1 py-4 px-6 text-center font-button text-button text-primary dark:text-primary-fixed-dim border-b-2 border-primary dark:border-primary-fixed-dim bg-slate-50/50 dark:bg-on-secondary-fixed-variant/20 flex items-center justify-center gap-2 cursor-pointer focus:outline-none">
            <span class="material-symbols-outlined">edit_document</span>
            Dán văn bản
        </button>
        <button class="flex-1 py-4 px-6 text-center font-button text-button text-secondary dark:text-secondary-fixed-dim hover:text-primary dark:hover:text-primary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant transition-colors flex items-center justify-center gap-2 cursor-pointer focus:outline-none">
            <span class="material-symbols-outlined">upload_file</span>
            Tải file
        </button>
        <button class="flex-1 py-4 px-6 text-center font-button text-button text-secondary dark:text-secondary-fixed-dim hover:text-primary dark:hover:text-primary-fixed-dim hover:bg-slate-50 dark:hover:bg-on-secondary-fixed-variant transition-colors flex items-center justify-center gap-2 cursor-pointer focus:outline-none">
            <span class="material-symbols-outlined">link</span>
            Nhập link
        </button>
    </div>
    
    <!-- Input Area -->
    <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Text Area (Active Tab) -->
        <div class="flex flex-col gap-4">
            <label class="font-button text-button text-on-surface dark:text-primary-fixed-dim">Nội dung văn bản</label>
            <textarea class="w-full h-64 p-4 rounded-lg border border-slate-200 dark:border-outline-variant focus:border-primary focus:ring-1 focus:ring-primary dark:focus:border-primary-fixed-dim outline-none resize-none font-body text-body text-on-surface dark:text-on-surface bg-surface-bright dark:bg-surface-dim/20 shadow-inner" placeholder="Dán hoặc nhập nội dung bài học, tài liệu của bạn vào đây... (Tối đa 5000 từ)"></textarea>
            <div class="flex justify-between items-center text-caption font-caption text-secondary dark:text-secondary-fixed-dim">
                <span>Đã nhập: 0 từ</span>
                <span>Tối đa: 5000 từ</span>
            </div>
        </div>
        
        <!-- Drop Zone Hint / Context -->
        <div class="bg-slate-50 dark:bg-on-secondary-fixed-variant/10 border-2 border-dashed border-slate-300 dark:border-outline-variant rounded-lg flex flex-col items-center justify-center p-8 text-center gap-4 hover:border-primary dark:hover:border-primary-fixed-dim hover:bg-surface-container-low dark:hover:bg-secondary-container transition-colors group cursor-pointer h-64 lg:h-auto">
            <div class="w-16 h-16 rounded-full bg-slate-100 dark:bg-secondary-container group-hover:bg-primary-fixed-dim flex items-center justify-center transition-colors shadow-sm">
                <span class="material-symbols-outlined text-secondary dark:text-secondary-fixed-dim group-hover:text-primary text-[32px]">cloud_upload</span>
            </div>
            <div>
                <p class="font-button text-button text-on-surface dark:text-primary-fixed-dim mb-1">Hoặc kéo thả file vào đây</p>
                <p class="font-caption text-caption text-secondary dark:text-secondary-fixed-dim">Hỗ trợ PDF, DOCX, TXT (Tối đa 10MB)</p>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Actions -->
<div class="flex justify-between items-center pt-2">
    <button class="px-6 py-2 rounded-lg font-button text-button text-secondary dark:text-secondary-fixed-dim hover:bg-slate-100 dark:hover:bg-secondary-container transition-colors cursor-pointer">
        Hủy bỏ
    </button>
    <a href="/Exam" class="px-6 py-3 rounded-lg font-button text-button bg-[#0037b0] dark:bg-primary text-on-primary hover:bg-opacity-90 dark:hover:bg-opacity-80 transition-colors shadow-sm flex items-center gap-2 cursor-pointer">
        Tiếp theo
        <span class="material-symbols-outlined" style="font-size: 18px;">arrow_forward</span>
    </a>
</div>
