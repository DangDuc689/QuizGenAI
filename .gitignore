.vs/

# Bỏ qua các thư mục build và file tạm của .NET
obj/
bin/

*.user

# Bỏ qua file tài liệu người dùng upload khi chạy app
# Chỉ giữ file .gitkeep để Git theo dõi cấu trúc thư mục uploads/documents
QuizGenAI/wwwroot/uploads/documents/*
!QuizGenAI/wwwroot/uploads/documents/.gitkeep
QuizGenAI/wwwroot/uploads/debug-docx-images/
QuizGenAI/TASK_*.md

# Bỏ qua ảnh đại diện do người dùng tải lên khi chạy app
QuizGenAI/wwwroot/uploads/avatars/*
!QuizGenAI/wwwroot/uploads/avatars/.gitkeep

# Bỏ qua cấu hình chứa keys thật của môi trường local
QuizGenAI/appsettings.json
